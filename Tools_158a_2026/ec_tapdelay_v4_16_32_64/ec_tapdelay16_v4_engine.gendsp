          "code": "// One private circular-buffer channel per connected input (not per tap).\n// Buffer dimensions are managed at DSP setup; delay messages never resize it.\nBuffer memory(\"memory\");\nParam bankready(0);\nParam running(1);\nParam driftonly(0);\nParam bankepoch(0);\nHistory writepos(0);\nHistory seenbank(-1);\nParam revision(0);\nParam smoothms(50);\nParam master(1);\nHistory masterz(1);\nParam source1(0);\nParam time1(0);\nParam gain1(1);\nHistory oldtime1(0);\nHistory newtime1(0);\nHistory oldgain1(0);\nHistory newgain1(0);\nHistory phase1(1);\nHistory seen1(-1);\nParam source2(1);\nParam time2(250);\nParam gain2(1);\nHistory oldtime2(0);\nHistory newtime2(0);\nHistory oldgain2(0);\nHistory newgain2(0);\nHistory phase2(1);\nHistory seen2(-1);\nParam source3(2);\nParam time3(500);\nParam gain3(1);\nHistory oldtime3(0);\nHistory newtime3(0);\nHistory oldgain3(0);\nHistory newgain3(0);\nHistory phase3(1);\nHistory seen3(-1);\nParam source4(3);\nParam time4(750);\nParam gain4(1);\nHistory oldtime4(0);\nHistory newtime4(0);\nHistory oldgain4(0);\nHistory newgain4(0);\nHistory phase4(1);\nHistory seen4(-1);\nParam source5(4);\nParam time5(1000);\nParam gain5(0);\nHistory oldtime5(0);\nHistory newtime5(0);\nHistory oldgain5(0);\nHistory newgain5(0);\nHistory phase5(1);\nHistory seen5(-1);\nParam source6(5);\nParam time6(1250);\nParam gain6(0);\nHistory oldtime6(0);\nHistory newtime6(0);\nHistory oldgain6(0);\nHistory newgain6(0);\nHistory phase6(1);\nHistory seen6(-1);\nParam source7(6);\nParam time7(1500);\nParam gain7(0);\nHistory oldtime7(0);\nHistory newtime7(0);\nHistory oldgain7(0);\nHistory newgain7(0);\nHistory phase7(1);\nHistory seen7(-1);\nParam source8(7);\nParam time8(1750);\nParam gain8(0);\nHistory oldtime8(0);\nHistory newtime8(0);\nHistory oldgain8(0);\nHistory newgain8(0);\nHistory phase8(1);\nHistory seen8(-1);\nParam source9(8);\nParam time9(2000);\nParam gain9(0);\nHistory oldtime9(0);\nHistory newtime9(0);\nHistory oldgain9(0);\nHistory newgain9(0);\nHistory phase9(1);\nHistory seen9(-1);\nParam source10(9);\nParam time10(2250);\nParam gain10(0);\nHistory oldtime10(0);\nHistory newtime10(0);\nHistory oldgain10(0);\nHistory newgain10(0);\nHistory phase10(1);\nHistory seen10(-1);\nParam source11(10);\nParam time11(2500);\nParam gain11(0);\nHistory oldtime11(0);\nHistory newtime11(0);\nHistory oldgain11(0);\nHistory newgain11(0);\nHistory phase11(1);\nHistory seen11(-1);\nParam source12(11);\nParam time12(2750);\nParam gain12(0);\nHistory oldtime12(0);\nHistory newtime12(0);\nHistory oldgain12(0);\nHistory newgain12(0);\nHistory phase12(1);\nHistory seen12(-1);\nParam source13(12);\nParam time13(3000);\nParam gain13(0);\nHistory oldtime13(0);\nHistory newtime13(0);\nHistory oldgain13(0);\nHistory newgain13(0);\nHistory phase13(1);\nHistory seen13(-1);\nParam source14(13);\nParam time14(3250);\nParam gain14(0);\nHistory oldtime14(0);\nHistory newtime14(0);\nHistory oldgain14(0);\nHistory newgain14(0);\nHistory phase14(1);\nHistory seen14(-1);\nParam source15(14);\nParam time15(3500);\nParam gain15(0);\nHistory oldtime15(0);\nHistory newtime15(0);\nHistory oldgain15(0);\nHistory newgain15(0);\nHistory phase15(1);\nHistory seen15(-1);\nParam source16(15);\nParam time16(3750);\nParam gain16(0);\nHistory oldtime16(0);\nHistory newtime16(0);\nHistory oldgain16(0);\nHistory newgain16(0);\nHistory phase16(1);\nHistory seen16(-1);\nframes = max(2, dim(memory));\nwritehead = wrap(writepos, 0, frames);\nresetbank = (seenbank != bankepoch);\nif (resetbank) { writehead = 0; }\nseenbank = bankepoch;\nstep = 1 / max(1, smoothms * samplerate * 0.001);\nmg = masterz + clamp(master - masterz, -step, step);\nmasterz = mg;\n// Write current inputs BEFORE reads: delay 0 reads the current sample.\n// Keep input history recording even while taps are silent.\nif ((running > 0) && (bankready > 0) && (frames > 2)) {\n    if (channels(memory) >= 1) { poke(memory, in1, writehead, 0); }\n    if (channels(memory) >= 2) { poke(memory, in2, writehead, 1); }\n    if (channels(memory) >= 3) { poke(memory, in3, writehead, 2); }\n    if (channels(memory) >= 4) { poke(memory, in4, writehead, 3); }\n    if (channels(memory) >= 5) { poke(memory, in5, writehead, 4); }\n    if (channels(memory) >= 6) { poke(memory, in6, writehead, 5); }\n    if (channels(memory) >= 7) { poke(memory, in7, writehead, 6); }\n    if (channels(memory) >= 8) { poke(memory, in8, writehead, 7); }\n    if (channels(memory) >= 9) { poke(memory, in9, writehead, 8); }\n    if (channels(memory) >= 10) { poke(memory, in10, writehead, 9); }\n    if (channels(memory) >= 11) { poke(memory, in11, writehead, 10); }\n    if (channels(memory) >= 12) { poke(memory, in12, writehead, 11); }\n    if (channels(memory) >= 13) { poke(memory, in13, writehead, 12); }\n    if (channels(memory) >= 14) { poke(memory, in14, writehead, 13); }\n    if (channels(memory) >= 15) { poke(memory, in15, writehead, 14); }\n    if (channels(memory) >= 16) { poke(memory, in16, writehead, 15); }\n}\n\n// Reset pending tap transitions on stop or history replacement.\nif (resetbank || (running <= 0)) {\n    oldtime1=0; newtime1=0; oldgain1=0; newgain1=0; phase1=1; seen1=-1;\n    oldtime2=0; newtime2=0; oldgain2=0; newgain2=0; phase2=1; seen2=-1;\n    oldtime3=0; newtime3=0; oldgain3=0; newgain3=0; phase3=1; seen3=-1;\n    oldtime4=0; newtime4=0; oldgain4=0; newgain4=0; phase4=1; seen4=-1;\n    oldtime5=0; newtime5=0; oldgain5=0; newgain5=0; phase5=1; seen5=-1;\n    oldtime6=0; newtime6=0; oldgain6=0; newgain6=0; phase6=1; seen6=-1;\n    oldtime7=0; newtime7=0; oldgain7=0; newgain7=0; phase7=1; seen7=-1;\n    oldtime8=0; newtime8=0; oldgain8=0; newgain8=0; phase8=1; seen8=-1;\n    oldtime9=0; newtime9=0; oldgain9=0; newgain9=0; phase9=1; seen9=-1;\n    oldtime10=0; newtime10=0; oldgain10=0; newgain10=0; phase10=1; seen10=-1;\n    oldtime11=0; newtime11=0; oldgain11=0; newgain11=0; phase11=1; seen11=-1;\n    oldtime12=0; newtime12=0; oldgain12=0; newgain12=0; phase12=1; seen12=-1;\n    oldtime13=0; newtime13=0; oldgain13=0; newgain13=0; phase13=1; seen13=-1;\n    oldtime14=0; newtime14=0; oldgain14=0; newgain14=0; phase14=1; seen14=-1;\n    oldtime15=0; newtime15=0; oldgain15=0; newgain15=0; phase15=1; seen15=-1;\n    oldtime16=0; newtime16=0; oldgain16=0; newgain16=0; phase16=1; seen16=-1;\n}\n\n// Audio-side guard: a drift commit cannot begin until every old fade finishes.\ndriftbusy = 0;\nif (driftonly > 0) { driftbusy = (phase1 < 1) + (phase2 < 1) + (phase3 < 1) + (phase4 < 1) + (phase5 < 1) + (phase6 < 1) + (phase7 < 1) + (phase8 < 1) + (phase9 < 1) + (phase10 < 1) + (phase11 < 1) + (phase12 < 1) + (phase13 < 1) + (phase14 < 1) + (phase15 < 1) + (phase16 < 1); }\n\n// Tap 1: zero-gain settled taps skip the processing branch.\nout1 = 0;\nif ((running > 0) && (bankready > 0) && (frames > 2) && ((gain1 > 0) || (newgain1 > 0) || (phase1 < 1))) {\n    ot1 = oldtime1; nt1 = newtime1;\n    og1 = oldgain1; ng1 = newgain1;\n    p1 = phase1; s1 = seen1;\n    if (resetbank) { ot1=0; nt1=0; og1=0; ng1=0; p1=1; s1=-1; }\n    if ((p1 >= 1) && (revision != s1) && ((driftonly <= 0) || (driftbusy <= 0))) {\n        target1 = clamp(time1 * samplerate * 0.001, 0, min(frames-2, samplerate*10));\n        if ((target1 != nt1) || (gain1 != ng1)) {\n            ot1 = nt1; og1 = ng1;\n            nt1 = target1; ng1 = gain1; p1 = 0;\n        }\n        s1 = revision;\n    }\n    if (p1 < 1) {\n        p1 = min(1, p1 + step);\n        // Gain-only changes need only one read.\n        if (ot1 == nt1) {\n            out1 = peek(memory, writehead - nt1, source1, interp=\"linear\", boundmode=\"wrap\", channelmode=\"ignore\") * ((1-p1) * og1 + p1 * ng1) * mg;\n        } else {\n            a1 = 0; b1 = 0;\n            if ((og1 > 0) && (p1 < 1)) { a1 = peek(memory, writehead - ot1, source1, interp=\"linear\", boundmode=\"wrap\", channelmode=\"ignore\"); }\n            if (ng1 > 0) { b1 = peek(memory, writehead - nt1, source1, interp=\"linear\", boundmode=\"wrap\", channelmode=\"ignore\"); }\n            out1 = ((1-p1) * og1 * a1 + p1 * ng1 * b1) * mg;\n        }\n    } else {\n        if (ng1 > 0) { out1 = peek(memory, writehead - nt1, source1, interp=\"linear\", boundmode=\"wrap\", channelmode=\"ignore\") * ng1 * mg; }\n    }\n    oldtime1 = ot1; newtime1 = nt1;\n    oldgain1 = og1; newgain1 = ng1;\n    phase1 = p1; seen1 = s1;\n}\n// Tap 2: zero-gain settled taps skip the processing branch.\nout2 = 0;\nif ((running > 0) && (bankready > 0) && (frames > 2) && ((gain2 > 0) || (newgain2 > 0) || (phase2 < 1))) {\n    ot2 = oldtime2; nt2 = newtime2;\n    og2 = oldgain2; ng2 = newgain2;\n    p2 = phase2; s2 = seen2;\n    if (resetbank) { ot2=0; nt2=0; og2=0; ng2=0; p2=1; s2=-1; }\n    if ((p2 >= 1) && (revision != s2) && ((driftonly <= 0) || (driftbusy <= 0))) {\n        target2 = clamp(time2 * samplerate * 0.001, 0, min(frames-2, samplerate*10));\n        if ((target2 != nt2) || (gain2 != ng2)) {\n            ot2 = nt2; og2 = ng2;\n            nt2 = target2; ng2 = gain2; p2 = 0;\n        }\n        s2 = revision;\n    }\n    if (p2 < 1) {\n        p2 = min(1, p2 + step);\n        // Gain-only changes need only one read.\n        if (ot2 == nt2) {\n            out2 = peek(memory, writehead - nt2, source2, interp=\"linear\", boundmode=\"wrap\", channelmode=\"ignore\") * ((1-p2) * og2 + p2 * ng2) * mg;\n        } else {\n            a2 = 0; b2 = 0;\n            if ((og2 > 0) && (p2 < 1)) { a2 = peek(memory, writehead - ot2, source2, interp=\"linear\", boundmode=\"wrap\", channelmode=\"ignore\"); }\n            if (ng2 > 0) { b2 = peek(memory, writehead - nt2, source2, interp=\"linear\", boundmode=\"wrap\", channelmode=\"ignore\"); }\n            out2 = ((1-p2) * og2 * a2 + p2 * ng2 * b2) * mg;\n        }\n    } else {\n        if (ng2 > 0) { out2 = peek(memory, writehead - nt2, source2, interp=\"linear\", boundmode=\"wrap\", channelmode=\"ignore\") * ng2 * mg; }\n    }\n    oldtime2 = ot2; newtime2 = nt2;\n    oldgain2 