1) + (phase2 < 1) + (phase3 < 1) + (phase4 < 1) + (phase5 < 1) + (phase6 < 1) + (phase7 < 1) + (phase8 < 1) + (phase9 < 1) + (phase10 < 1) + (phase11 < 1) + (phase12 < 1) + (phase13 < 1) + (phase14 < 1) + (phase15 < 1) + (phase16 < 1) + (phase17 < 1) + (phase18 < 1) + (phase19 < 1) + (phase20 < 1) + (phase21 < 1) + (phase22 < 1) + (phase23 < 1) + (phase24 < 1) + (phase25 < 1) + (phase26 < 1) + (phase27 < 1) + (phase28 < 1) + (phase29 < 1) + (phase30 < 1) + (phase31 < 1) + (phase32 < 1); }\n\n// Tap 1: zero-gain settled taps skip the processing branch.\nout1 = 0;\nif ((running > 0) && (bankready > 0) && (frames > 2) && ((gain1 > 0) || (newgain1 > 0) || (phase1 < 1))) {\n    ot1 = oldtime1; nt1 = newtime1;\n    og1 = oldgain1; ng1 = newgain1;\n    p1 = phase1; s1 = seen1;\n    if (resetbank) { ot1=0; nt1=0; og1=0; ng1=0; p1=1; s1=-1; }\n    if ((p1 >= 1) && (revision != s1) && ((driftonly <= 0) || (driftbusy <= 0))) {\n        target1 = clamp(time1 * samplerate * 0.001, 0, min(frames-2, samplerate*10));\n        if ((target1 != nt1) || (gain1 != ng1)) {\n            ot1 = nt1; og1 = ng1;\n            nt1 = target1; ng1 = gain1; p1 = 0;\n        }\n        s1 = revision;\n    }\n    if (p1 < 1) {\n        p1 = min(1, p1 + step);\n        // Gain-only changes need only one read.\n        if (ot1 == nt1) {\n            out1 = peek(memory, writehead - nt1, source1, interp=\"linear\", boundmode=\"wrap\", channelmode=\"ignore\") * ((1-p1) * og1 + p1 * ng1) * mg;\n        } else {\n            a1 = 0; b1 = 0;\n            if ((og1 > 0) && (p1 < 1)) { a1 = peek(memory, writehead - ot1, source1, interp=\"linear\", boundmode=\"wrap\", channelmode=\"ignore\"); }\n            if (ng1 > 0) { b1 = peek(memory, writehead - nt1, source1, interp=\"linear\", boundmode=\"wrap\", channelmode=\"ignore\"); }\n            out1 = ((1-p1) * og1 * a1 + p1 * ng1 * b1) * mg;\n        }\n    } else {\n        if (ng1 > 0) { out1 = peek(memory, writehead - nt1, source1, interp=\"linear\", boundmode=\"wrap\", channelmode=\"ignore\") * ng1 * mg; }\n    }\n    oldtime1 = ot1; newtime1 = nt1;\n    oldgain1 = og1; newgain1 = ng1;\n    phase1 = p1; seen1 = s1;\n}\n// Tap 2: zero-gain settled taps skip the processing branch.\nout2 = 0;\nif ((running > 0) && (bankready > 0) && (frames > 2) && ((gain2 > 0) || (newgain2 > 0) || (phase2 < 1))) {\n    ot2 = oldtime2; nt2 = newtime2;\n    og2 = oldgain2; ng2 = newgain2;\n    p2 = phase2; s2 = seen2;\n    if (resetbank) { ot2=0; nt2=0; og2=0; ng2=0; p2=1; s2=-1; }\n    if ((p2 >= 1) && (revision != s2) && ((driftonly <= 0) || (driftbusy <= 0))) {\n        target2 = clamp(time2 * samplerate * 0.001, 0, min(frames-2, samplerate*10));\n        if ((target2 != nt2) || (gain2 != ng2)) {\n            ot2 = nt2; og2 = ng2;\n            nt2 = target2; ng2 = gain2; p2 = 0;\n        }\n        s2 = revision;\n    }\n    if (p2 < 1) {\n        p2 = min(1, p2 + step);\n        // Gain-only changes need only one read.\n        if (ot2 == nt2) {\n            out2 = peek(memory, writehead - nt2, source2, interp=\"linear\", boundmode=\"wrap\", channelmode=\"ignore\") * ((1-p2) * og2 + p2 * ng2) * mg;\n        } else {\n            a2 = 0; b2 = 0;\n            if ((og2 > 0) && (p2 < 1)) { a2 = peek(memory, writehead - ot2, source2, interp=\"linear\", boundmode=\"wrap\", channelmode=\"ignore\"); }\n            if (ng2 > 0) { b2 = peek(memory, writehead - nt2, source2, interp=\"linear\", boundmode=\"wrap\", channelmode=\"ignore\"); }\n            out2 = ((1-p2) * og2 * a2 + p2 * ng2 * b2) * mg;\n        }\n    } else {\n        if (ng2 > 0) { out2 = peek(memory, writehead - nt2, source2, interp=\"linear\", boundmode=\"wrap\", channelmode=\"ignore\") * ng2 * mg; }\n    }\n    oldtime2 = ot2; newtime2 = nt2;\n    oldgain2 = og2; newgain2 = ng2;\n    phase2 = p2; seen2 = s2;\n}\n// Tap 3: zero-gain settled taps skip the processing branch.\nout3 = 0;\nif ((running > 0) && (bankready > 0) && (frames > 2) && ((gain3 > 0) || (newgain3 > 0) || (pha