y) >= 15) { poke(memory, in15, writehead, 14); }\n    if (channels(memory) >= 16) { poke(memory, in16, writehead, 15); }\n    if (channels(memory) >= 17) { poke(memory, in17, writehead, 16); }\n    if (channels(memory) >= 18) { poke(memory, in18, writehead, 17); }\n    if (channels(memory) >= 19) { poke(memory, in19, writehead, 18); }\n    if (channels(memory) >= 20) { poke(memory, in20, writehead, 19); }\n    if (channels(memory) >= 21) { poke(memory, in21, writehead, 20); }\n    if (channels(memory) >= 22) { poke(memory, in22, writehead, 21); }\n    if (channels(memory) >= 23) { poke(memory, in23, writehead, 22); }\n    if (channels(memory) >= 24) { poke(memory, in24, writehead, 23); }\n    if (channels(memory) >= 25) { poke(memory, in25, writehead, 24); }\n    if (channels(memory) >= 26) { poke(memory, in26, writehead, 25); }\n    if (channels(memory) >= 27) { poke(memory, in27, writehead, 26); }\n    if (channels(memory) >= 28) { poke(memory, in28, writehead, 27); }\n    if (channels(memory) >= 29) { poke(memory, in29, writehead, 28); }\n    if (channels(memory) >= 30) { poke(memory, in30, writehead, 29); }\n    if (channels(memory) >= 31) { poke(memory, in31, writehead, 30); }\n    if (channels(memory) >= 32) { poke(memory, in32, writehead, 31); }\n}\n\n// Reset pending tap transitions on stop or history replacement.\nif (resetbank || (running <= 0)) {\n    oldtime1=0; newtime1=0; oldgain1=0; newgain1=0; phase1=1; seen1=-1;\n    oldtime2=0; newtime2=0; oldgain2=0; newgain2=0; phase2=1; seen2=-1;\n    oldtime3=0; newtime3=0; oldgain3=0; newgain3=0; phase3=1; seen3=-1;\n    oldtime4=0; newtime4=0; oldgain4=0; newgain4=0; phase4=1; seen4=-1;\n    oldtime5=0; newtime5=0; oldgain5=0; newgain5=0; phase5=1; seen5=-1;\n    oldtime6=0; newtime6=0; oldgain6=0; newgain6=0; phase6=1; seen6=-1;\n    oldtime7=0; newtime7=0; oldgain7=0; newgain7=0; phase7=1; seen7=-1;\n    oldtime8=0; newtime8=0; oldgain8=0; newgain8=0; phase8=1; seen8=-1;\n    oldtime9=0; newtime9=0; oldgain