                                            },
                                            {
                                                "box": {
                                                    "id": "drift-explanation-v19-0",
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 25.0, 190.0, 980.0, 42.0 ],
                                                    "text": "Chooses a repeatable random sequence. Changing the seed restarts every partial at zero drift offset; it does not alter the Detune sliders."
                                                }
                                            },
                                            {
                                                "box": {
                                                    "id": "drift-explanation-v19-1",
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 25.0, 315.0, 980.0, 42.0 ],
                                                    "text": "1 starts independent walks around the current Detune frequencies. 0 stops them, clears accumulated offsets, and restores the exact slider-set frequencies."
                                                }
                                            },
                                            {
                                                "box": {
                                                    "id": "drift-explanation-v19-2",
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 25.0, 440.0, 980.0, 42.0 ],
                                                    "text": "Each selection moves one step above or below the preceding target with a 50/50 probability. Default is 1 Hz. The optional second value ramps this control."
                                                }
                                            },
                                            {
                                                "box": {
                                                    "id": "drift-explanation-v19-3",
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 25.0, 565.0, 980.0, 42.0 ],
                                                    "text": "Sets the approximate glide time between random targets. Each partial independently uses 75%–125% of this time. The optional second value ramps this control."
                                                }
                                            },
                                            {
                                                "box": {
                                                    "id": "drift-amount-explanation-v19",
                                                    "linecount": 2,
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 25.0, 625.0, 980.0, 48.0 ],
                                                    "text": "DRIFT AMOUNT uses Max_Drift_v19 in the Core cue group: 0 stops and resets the walk; 1 applies the full accumulated Hz offset; intermediate values scale it. Both Drift Amount and Micro-Drift ON must be above zero for motion."
                                                }
                                            }
                                        ],
