                    "bgfillcolor_proportion": 0.5,
                    "bgfillcolor_type": "gradient",
                    "id": "obj-76",
                    "items": [ "Interleaved", ",", "Spectral Bands", ",", "Seeded Random", ",", "Octave Families" ],
                    "maxclass": "umenu",
                    "numinlets": 1,
                    "numoutlets": 3,
                    "outlettype": [ "int", "", "" ],
                    "parameter_enable": 0,
                    "patching_rect": [ 573.0, 2505.0, 240.0, 22.0 ],
