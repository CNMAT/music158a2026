                    "presentation_rect": [ 368.5, 764.0, 163.0, 22.0 ],
                    "saved_object_attributes": {
                        "locked_bgcolor": [ 0.92, 0.92, 0.92, 1.0 ]
                    },
                    "text": "p Partial_Distributions_HELP"
                }
