                    "id": "global-flat-zero14",
                    "maxclass": "message",
                    "numinlets": 2,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 734.0, 562.5, 102.0, 29.0 ],
                    "presentation": 1,
                    "presentation_rect": [ 551.0, 50.0, 46.0, 29.0 ],
                    "text": "alloff"
                }
            },
            {
                "box": {
                    "id": "global-flat-zero-note14",
                    "linecount": 3,
                    "maxclass": "comment",
                    "numinlets": 1,
                    "numoutlets": 0,
                    "patching_rect": [ 811.0, 563.5, 506.0, 47.0 ],
                    "presentation": 1,
                    "presentation_linecount": 3,
                    "presentation_rect": [ 385.0, 41.0, 163.0, 47.0 ],
                    "text": "alloff message clears all 256 \nslots in all three multisliders; \nvisible count stays as set."
                }
            },
            {
                "box": {
                    "bgcolor": [ 0.973, 0.463, 0.502, 1 ],
                    "bgcolor2": [ 0.2, 0.2, 0.2, 1 ],
                    "bgfillcolor_angle": 270,
                    "bgfillcolor_autogradient": 0.0,
                    "bgfillcolor_color": [ 0.973, 0.463, 0.502, 1 ],
                    "bgfillcolor_color1": [ 0.973, 0.463, 0.502, 1 ],
                    "bgfillcolor_color2": [ 0.2, 0.2, 0.2, 1 ],
                    "bgfillcolor_proportion": 0.5,
