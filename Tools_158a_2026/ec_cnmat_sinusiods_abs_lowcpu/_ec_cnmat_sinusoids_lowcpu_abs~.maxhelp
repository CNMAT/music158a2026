                                                    "patching_rect": [ 25.0, 628.0, 455.0, 68.0 ],
                                                    "text": "Use two-digit lane numbers 01–12 in messages. Delay can be 0–3,600,000 ms. Changing DEL affects the next trigger; it does not move an already scheduled start.",
                                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
