                                                    "id": "title",
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 25.0, 18.0, 965.0, 31.0 ],
                                                    "text": "01 / Quick start"
                                                }
                                            },
                                            {
                                                "box": {
                                                    "fontface": 0,
                                                    "fontname": "Arial",
                                                    "fontsize": 13.0,
                                                    "id": "guide",
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 25.0, 62.0, 955.0, 21.0 ],
                                                    "text": "Click message examples to address the demo instrument when this page is opened from the help file. Close this window to return to the index."
                                                }
                                            },
                                            {
                                                "box": {
                                                    "fontface": 1,
                                                    "fontname": "Arial",
                                                    "fontsize": 16.0,
                                                    "id": "c0-0",
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 25.0, 120.0, 455.0, 24.0 ],
                                                    "text": "Open the complete folder"
                                                }
                                            },
                                            {
                                                "box": {
                                                    "fontface": 0,
                                                    "fontname": "Arial",
                                                    "fontsize": 14.0,
                                                    "id": "c0-1",
                                                    "linecount": 4,
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 25.0, 164.0, 455.0, 69.0 ],
                                                    "text": "Keep ec_cnmat_sinusoids_lowcpu_abs~.maxpat beside dependencies/. Open _ec_cnmat_sinusoids_lowcpu_abs~.maxhelp. The CNMAT sinusoids~ external must be installed. No previous synth version, SPAT, or ml.star package is required by this demo."
                                                }
                                            },
                                            {
                                                "box": {
                                                    "fontface": 1,
                                                    "fontname": "Arial",
                                                    "fontsize": 16.0,
                                                    "id": "c0-2",
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 25.0, 303.0, 455.0, 24.0 ],
                                                    "text": "Make a first sound"
                                                }
                                            },
                                            {
                                                "box": {
                                                    "fontface": 0,
                                                    "fontname": "Arial",
                                                    "fontsize": 14.0,
                                                    "id": "c0-3",
                                                    "linecount": 4,
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 25.0, 347.0, 455.0, 69.0 ],
                                                    "text": "1. Enable audio with the speaker button in the help patch.\n2. Bring up the help patch’s monitor gain.\n3. Click the setup message below; then the note message. This sets a 32-position spectrum and a 2-second triangular envelope."
                                                }
                                            },
                                            {
                                                "box": {
                                                    "fontsize": 13.0,
                                                    "id": "c0-4",
                                                    "maxclass": "message",
                                                    "numinlets": 2,
                                                    "numoutlets": 1,
                                                    "outlettype": [ "" ],
                                                    "patching_rect": [ 25.0, 486.0, 354.0, 23.0 ],
                                                    "text": "gain 0.1, control Render_Limit 128, control Partial_Count 32"
                                                }
                                            },
                                            {
                                                "box": {
                                                    "fontsize": 13.0,
                                                    "id": "c0-5",
                                                    "maxclass": "message",
                                                    "numinlets": 2,
                                                    "numoutlets": 1,
                                                    "outlettype": [ "" ],
                                                    "patching_rect": [ 25.0, 526.0, 369.0, 23.0 ],
                                                    "text": "control Amplitude_Shape 4, control ADSR_12_Lanes_Shape 6"
                                                }
                                            },
                                            {
                                                "box": {
                                                    "fontsize": 13.0,
                                                    "id": "c0-6",
                                                    "maxclass": "message",
                                                    "numinlets": 2,
                                                    "numoutlets": 1,
                                                    "outlettype": [ "" ],
                                                    "patching_rect": [ 25.0, 566.0, 264.0, 23.0 ],
                                                    "text": "control ADSR_12_Lanes_Duration_ms 2000"
                                                }
                                            },
                                            {
                                                "box": {
                                                    "fontsize": 13.0,
                                                    "id": "c0-7",
                                                    "maxclass": "message",
                                                    "numinlets": 2,
                                                    "numoutlets": 1,
                                                    "outlettype": [ "" ],
                                                    "patching_rect": [ 25.0, 606.0, 92.0, 23.0 ],
                                                    "text": "note-in 48 100"
                                                }
                                            },
                                            {
                                                "box": {
                                                    "fontface": 0,
                                                    "fontname": "Arial",
                                                    "fontsize": 14.0,
                                                    "id": "c0-8",
                                                    "linecount": 3,
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 25.0, 646.0, 455.0, 53.0 ],
                                                    "text": "Click the help keyboard to set pitch and trigger the lanes. The instrument’s internal keyboard also starts all 12 ADSR lanes automatically, after updating the source frequency."
                                                }
                                            },
                                            {
                                                "box": {
                                                    "fontface": 1,
                                                    "fontname": "Arial",
                                                    "fontsize": 16.0,
                                                    "id": "c1-0",
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 520.0, 120.0, 455.0, 24.0 ],
                                                    "text": "Open the instrument"
                                                }
                                            },
                                            {
                                                "box": {
                                                    "fontface": 0,
                                                    "fontname": "Arial",
                                                    "fontsize": 14.0,
                                                    "id": "c1-1",
                                                    "linecount": 4,
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 520.0, 164.0, 455.0, 69.0 ],
                                                    "text": "Double-click ec_cnmat_sinusoids_lowcpu_abs~. Its presentation contains the spectral sliders, retuning/filter controls, gain, and preset buttons. The RENDER LIMIT and PARTIAL TO SLIDER DISTRIBUTIONS menus are below PRESETS."
                                                }
                                            },
                                            {
                                                "box": {
                                                    "fontface": 1,
                                                    "fontname": "Arial",
                                                    "fontsize": 16.0,
                                                    "id": "c1-2",
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 520.0, 284.0, 455.0, 24.0 ],
                                                    "text": "Keyboard notes launch all 12 lanes"
                                                }
                                            },
                                            {
                                                "box": {
                                                    "fontface": 0,
                                                    "fontname": "Arial",
                                                    "fontsize": 14.0,
                                                    "id": "c1-3",
                                                    "linecount": 4,
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 520.0, 328.0, 455.0, 69.0 ],
                                                    "text": "note-in PITCH [VELOCITY] updates the source pitch through the visual keyboard, then triggers all 12 ADSR lanes once. MIDI pitch is 0–127; velocity defaults to 100. Velocity 0 is ignored. Each lane keeps its DEL. Repeating the same note retriggers. Velocity is not mapped to gain."
                                                }
                                            },
                                            {
                                                "box": {
                                                    "fontsize": 13.0,
                                                    "id": "c1-4",
                                                    "maxclass": "message",
                                                    "numinlets": 2,
                                                    "numoutlets": 1,
                                                    "outlettype": [ "" ],
                                                    "patching_rect": [ 520.0, 448.0, 450.0, 23.0 ],
                                                    "text": "note-in 48 100"
                                                }
                                            },
                                            {
                                                "box": {
                                                    "fontsize": 13.0,
                                                    "id": "c1-5",
                                                    "maxclass": "message",
                                                    "numinlets": 2,
                                                    "numoutlets": 1,
                                                    "outlettype": [ "" ],
                                                    "patching_rect": [ 520.0, 488.0, 450.0, 23.0 ],
                                                    "text": "control Source_Base_Hz 110"
                                                }
                                            },
                                            {
                                                "box": {
                                                    "fontsize": 13.0,
                                                    "id": "c1-6",
                                                    "maxclass": "message",
                                                    "numinlets": 2,
                                                    "numoutlets": 1,
                                                    "outlettype": [ "" ],
                                                    "patching_rect": [ 520.0, 528.0, 450.0, 23.0 ],
                                                    "text": "trigger"
                                                }
                                            },
                                            {
                                                "box": {
                                                    "fontsize": 13.0,
                                                    "id": "c1-7",
                                                    "maxclass": "message",
                                                    "numinlets": 2,
                                                    "numoutlets": 1,
                                                    "outlettype": [ "" ],
                                                    "patching_rect": [ 520.0, 568.0, 450.0, 23.0 ],
                                                    "text": "stop"
                                                }
                                            },
                                            {
                                                "box": {
                                                    "fontface": 0,
                                                    "fontname": "Arial",
                                                    "fontsize": 14.0,
                                                    "id": "c1-8",
                                                    "linecount": 3,
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 520.0, 608.0, 455.0, 53.0 ],
                                                    "text": "stop cancels pending starts and loops, stops playback, and fades the lane envelopes to zero in 5 ms. It preserves the spectrum. gain 0 also silences the output without erasing stored values."
                                                }
                                            },
                                            {
                                                "box": {
                                                    "fontsize": 13.0,
                                                    "id": "c1-9",
                                                    "maxclass": "message",
                                                    "numinlets": 2,
                                                    "numoutlets": 1,
                                                    "outlettype": [ "" ],
                                                    "patching_rect": [ 520.0, 708.0, 450.0, 23.0 ],
                                                    "text": "gain 0"
                                                }
                                            },
