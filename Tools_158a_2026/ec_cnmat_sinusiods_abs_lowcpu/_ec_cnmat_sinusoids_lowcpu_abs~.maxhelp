                                                    "id": "c0-2",
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 25.0, 362.0, 455.0, 32.0 ],
                                                    "text": "Shapes and morph times",
                                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
                                                }
                                            },
                                            {
                                                "box": {
                                                    "bgcolor": [ 1.0, 1.0, 1.0, 1.0 ],
                                                    "fontface": 0,
                                                    "fontname": "Arial",
                                                    "fontsize": 14.0,
                                                    "id": "c0-3",
                                                    "linecount": 7,
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 25.0, 406.0, 455.0, 166.0 ],
                                                    "text": "Choose a shape to write a curve across the current count. Amplitude/anchor menus use indices 0–24: 0 Flat Zero, 1 All on full, 4 Linear high-to-low, 6 Triangle. Detune has 94 signed/critical-band choices.\n\nEach layer has its own morph time. Count changes preserve the stored per-position values; they do not redistribute a shape.",
                                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
                                                }
                                            },
