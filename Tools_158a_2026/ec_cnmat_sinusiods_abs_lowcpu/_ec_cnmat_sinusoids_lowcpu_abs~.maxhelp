                                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
                                                }
                                            },
                                            {
                                                "box": {
                                                    "bgcolor": [ 1.0, 1.0, 1.0, 1.0 ],
                                                    "fontface": 1,
                                                    "fontname": "Arial",
                                                    "fontsize": 16.0,
                                                    "id": "c1-0",
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 520.0, 120.0, 455.0, 32.0 ],
                                                    "text": "“preset 3” is a format version",
                                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
                                                }
                                            },
                                            {
                                                "box": {
                                                    "bgcolor": [ 1.0, 1.0, 1.0, 1.0 ],
                                                    "fontface": 0,
                                                    "fontname": "Arial",
                                                    "fontsize": 14.0,
                                                    "id": "c1-1",
                                                    "linecount": 7,
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 520.0, 164.0, 455.0, 166.0 ],
                                                    "text": "The number identifies the encoding/schema version, not preset slot 3. Multiple presets can all begin “preset 3.” Name or organize their message boxes yourself. Do not edit the version number, checksum or encoded chunks.\n\nThis build retains format 3, so existing lowcpu presets remain usable. Formats 1 and 2 are migrated on recall.",
                                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
                                                }
                                            },
                                            {
                                                "box": {
                                                    "bgcolor": [ 1.0, 1.0, 1.0, 1.0 ],
                                                    "fontface": 1,
                                                    "fontname": "Arial",
                                                    "fontsize": 16.0,
                                                    "id": "c1-2",
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 520.0, 342.0, 455.0, 32.0 ],
                                                    "text": "What is saved",
                                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
                                                }
                                            },
                                            {
                                                "box": {
                                                    "bgcolor": [ 1.0, 1.0, 1.0, 1.0 ],
                                                    "fontface": 0,
                                                    "fontname": "Arial",
                                                    "fontsize": 14.0,
                                                    "id": "c1-3",
                                                    "linecount": 6,
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 520.0, 386.0, 455.0, 166.0 ],
                                                    "text": "209 UI controls, 25 engine states and 14 user stores, including all 256 spectral memory positions, lane delays/curves/loops, render limit, partial sequence, and gain.\n\nNot saved: oscillator phase, elapsed ADSR playback position, host DSP/audio settings, meters, or edits to patcher wiring.",
                                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
                                                }
                                            },
                                            {
                                                "box": {
                                                    "bgcolor": [ 1.0, 1.0, 1.0, 1.0 ],
                                                    "fontface": 1,
                                                    "fontname": "Arial",
                                                    "fontsize": 16.0,
                                                    "id": "c1-4",
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 520.0, 564.0, 455.0, 32.0 ],
                                                    "text": "Older presets",
                                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
                                                }
                                            },
                                            {
                                                "box": {
                                                    "bgcolor": [ 1.0, 1.0, 1.0, 1.0 ],
                                                    "fontface": 0,
                                                    "fontname": "Arial",
                                                    "fontsize": 14.0,
                                                    "id": "c1-5",
                                                    "linecount": 8,
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 520.0, 608.0, 455.0, 166.0 ],
                                                    "text": "Formats 1/2 default to Render Limit 128 and one-to-one. Format 1 supplies zero for the twelve DEL values; format 2 retains them. The count is clamped to the restored ceiling without deleting high-slot memory.\n\nTo recover a full stored spectrum: set limit 256, set count 256, then dump again. The two original example preset messages are preserved in the help file.",
                                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
                                                }
                                            },
                                            {
                                                "box": {
                                                    "bgcolor": [ 1.0, 1.0, 1.0, 1.0 ],
                                                    "fontface": 1,
                                                    "fontname": "Arial",
                                                    "fontsize": 16.0,
                                                    "id": "c1-6",
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 520.0, 786.0, 455.0, 32.0 ],
                                                    "text": "Diagnostics",
                                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
                                                }
                                            },
                                            {
                                                "box": {
                                                    "bgcolor": [ 1.0, 1.0, 1.0, 1.0 ],
                                                    "fontface": 0,
                                                    "fontname": "Arial",
                                                    "fontsize": 14.0,
                                                    "id": "c1-7",
                                                    "linecount": 3,
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 520.0, 830.0, 455.0, 88.0 ],
                                                    "text": "check verifies that all 25 preset engine endpoints respond. A successful dump reports its size/chunks. “Unknown message set” indicates the message-box storage/recall wiring should be checked.",
                                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
                                                }
                                            },
