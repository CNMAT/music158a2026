                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 25.0, 120.0, 455.0, 32.0 ],
                                                    "text": "The three multisliders",
                                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
                                                }
                                            },
                                            {
                                                "box": {
                                                    "bgcolor": [ 1.0, 1.0, 1.0, 1.0 ],
                                                    "fontface": 0,
                                                    "fontname": "Arial",
                                                    "fontsize": 14.0,
                                                    "id": "c0-1",
                                                    "linecount": 9,
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 25.0, 164.0, 455.0, 186.0 ],
                                                    "text": "DETUNE: −1 to +1 represents −100 to +100 cents around the selected multiple; 0 is exact. Only an actual 1× f0 partial is protected from detune/drift.\n\nPRIMARY AMPLITUDE: 0–1 per position.\n\nHARMONIC ANCHOR: a second amplitude bank at exact selected multiples, without primary detune/drift. Mixing a nearby detuned primary with its anchor produces beating.",
                                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
                                                }
                                            },
                                            {
                                                "box": {
                                                    "bgcolor": [ 1.0, 1.0, 1.0, 1.0 ],
                                                    "fontface": 1,
