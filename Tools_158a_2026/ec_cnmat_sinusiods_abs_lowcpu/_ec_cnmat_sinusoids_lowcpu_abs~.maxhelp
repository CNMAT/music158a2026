                                                    "text": "control Partial_Offset_Number 5",
                                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
                                                }
                                            },
                                            {
                                                "box": {
                                                    "bgcolor": [ 0.94, 0.94, 0.94, 1 ],
                                                    "bgcolor2": [ 0.94, 0.94, 0.94, 1 ],
                                                    "bgfillcolor_autogradient": 0.0,
                                                    "bgfillcolor_color": [ 0.2, 0.2, 0.2, 1 ],
                                                    "bgfillcolor_color1": [ 0.94, 0.94, 0.94, 1 ],
                                                    "bgfillcolor_color2": [ 0.2, 0.2, 0.2, 1 ],
                                                    "bgfillcolor_type": "color",
                                                    "fontsize": 13.0,
                                                    "gradient": 1,
                                                    "id": "c1-4",
                                                    "maxclass": "message",
                                                    "numinlets": 2,
                                                    "numoutlets": 1,
                                                    "outlettype": [ "" ],
                                                    "patching_rect": [ 520.0, 422.0, 450.0, 30.0 ],
                                                    "text": "control Partial_Offset_On 0",
                                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
                                                }
                                            },
                                            {
                                                "box": {
                                                    "bgcolor": [ 1.0, 1.0, 1.0, 1.0 ],
                                                    "fontface": 0,
                                                    "fontname": "Arial",
                                                    "fontsize": 14.0,
                                                    "id": "c1-5",
                                                    "linecount": 3,
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 520.0, 462.0, 455.0, 88.0 ],
                                                    "text": "Turning Offset ON resets its number to 1; enable it before setting N. Sequence and offset changes use the 150 ms two-bank crossfade. Rapid changes keep the most recent queued destination.",
                                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
