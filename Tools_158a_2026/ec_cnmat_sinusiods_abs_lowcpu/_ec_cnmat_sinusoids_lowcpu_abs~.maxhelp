                                                    "outlettype": [ "" ],
                                                    "patching_rect": [ 520.0, 342.0, 450.0, 30.0 ],
                                                    "text": "control Partial_Offset_On 1",
                                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
                                                }
                                            },
                                            {
                                                "box": {
                                                    "bgcolor": [ 0.94, 0.94, 0.94, 1 ],
                                                    "bgcolor2": [ 0.94, 0.94, 0.94, 1 ],
                                                    "bgfillcolor_autogradient": 0.0,
                                                    "bgfillcolor_color": [ 0.2, 0.2, 0.2, 1 ],
                                                    "bgfillcolor_color1": [ 0.94, 0.94, 0.94, 1 ],
                                                    "bgfillcolor_color2": [ 0.2, 0.2, 0.2, 1 ],
                                                    "bgfillcolor_type": "color",
                                                    "fontsize": 13.0,
                                                    "gradient": 1,
                                                    "id": "c1-3",
                                                    "maxclass": "message",
                                                    "numinlets": 2,
                                                    "numoutlets": 1,
