                                    "outlettype": [ "" ],
                                    "patcher": {
                                        "fileversion": 1,
                                        "appversion": {
                                            "major": 9,
                                            "minor": 2,
                                            "revision": 0,
                                            "architecture": "x64",
                                            "modernui": 1
                                        },
                                        "classnamespace": "box",
                                        "rect": [ 90.0, 70.0, 1020.0, 859.0 ],
                                        "default_fontsize": 14.0,
                                        "boxes": [
                                            {
                                                "box": {
                                                    "bgcolor": [ 1.0, 1.0, 1.0, 1.0 ],
                                                    "fontface": 1,
                                                    "fontname": "Arial",
                                                    "fontsize": 22.0,
                                                    "id": "title",
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 25.0, 18.0, 965.0, 40.0 ],
                                                    "text": "09 / CPU status and startup defaults",
                                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
                                                }
                                            },
                                            {
                                                "box": {
                                                    "bgcolor": [ 1.0, 1.0, 1.0, 1.0 ],
                                                    "fontface": 0,
                                                    "fontname": "Arial",
                                                    "fontsize": 13.0,
                                                    "id": "guide",
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 25.0, 62.0, 955.0, 46.0 ],
                                                    "text": "Click message examples to address the demo instrument when this page is opened from the help file. Close this window to return to the index.",
                                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
                                                }
                                            },
                                            {
                                                "box": {
                                                    "bgcolor": [ 1.0, 1.0, 1.0, 1.0 ],
                                                    "fontface": 1,
                                                    "fontname": "Arial",
                                                    "fontsize": 16.0,
                                                    "id": "c0-0",
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 25.0, 120.0, 455.0, 32.0 ],
                                                    "text": "Read the live status row",
                                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
                                                }
                                            },
                                            {
                                                "box": {
                                                    "bgcolor": [ 1.0, 1.0, 1.0, 1.0 ],
                                                    "fontface": 0,
                                                    "fontname": "Arial",
                                                    "fontsize": 14.0,
                                                    "id": "c0-1",
                                                    "linecount": 9,
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 25.0, 164.0, 455.0, 186.0 ],
                                                    "text": "Example: limit 128 slots 256 nonzero 128 banks 12\n\nlimit: selected position ceiling.\nslots: oscillator slots currently allocated.\nnonzero: model entries with nonzero amplitude.\nbanks: occupied lane/bank renderers, out of 24.\n\nThese describe the spectral renderer, not measured audibility after envelopes/gain.",
                                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
                                                }
                                            },
                                            {
                                                "box": {
                                                    "bgcolor": [ 1.0, 1.0, 1.0, 1.0 ],
                                                    "fontface": 1,
                                                    "fontname": "Arial",
                                                    "fontsize": 16.0,
                                                    "id": "c0-2",
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 25.0, 362.0, 455.0, 32.0 ],
                                                    "text": "What the optimization does",
                                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
                                                }
                                            },
                                            {
                                                "box": {
                                                    "bgcolor": [ 1.0, 1.0, 1.0, 1.0 ],
                                                    "fontface": 0,
                                                    "fontname": "Arial",
                                                    "fontsize": 14.0,
                                                    "id": "c0-3",
                                                    "linecount": 7,
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 25.0, 406.0, 455.0, 186.0 ],
                                                    "text": "Separate A/B banks for each of the 12 lanes receive only needed identities within the limit. Inactive banks receive clear. Unchanged bank models are not resent. The generator avoids unused duplicate model builds and sorting.\n\nThe old renderer sent 1,024 slots even at low counts. This version’s actual work follows the active model much more closely.",
                                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
                                                }
                                            },
                                            {
                                                "box": {
                                                    "bgcolor": [ 1.0, 1.0, 1.0, 1.0 ],
                                                    "fontface": 1,
                                                    "fontname": "Arial",
                                                    "fontsize": 16.0,
                                                    "id": "c0-4",
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 25.0, 604.0, 455.0, 32.0 ],
                                                    "text": "Why slots may be higher than expected",
                                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
                                                }
                                            },
                                            {
                                                "box": {
                                                    "bgcolor": [ 1.0, 1.0, 1.0, 1.0 ],
                                                    "fontface": 0,
                                                    "fontname": "Arial",
                                                    "fontsize": 14.0,
                                                    "id": "c0-5",
                                                    "linecount": 4,
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 25.0, 648.0, 455.0, 108.0 ],
                                                    "text": "A crossfade temporarily uses both banks. Departing partials fade before retirement. Silent partners and interior holes may remain to avoid moving sounding oscillators; they can persist until a bank becomes idle. Read actual slots after changes settle.",
                                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
                                                }
                                            },
                                            {
                                                "box": {
                                                    "bgcolor": [ 1.0, 1.0, 1.0, 1.0 ],
                                                    "fontface": 1,
                                                    "fontname": "Arial",
                                                    "fontsize": 16.0,
                                                    "id": "c1-0",
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 520.0, 120.0, 455.0, 32.0 ],
                                                    "text": "Startup values for the main workflow",
                                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
                                                }
                                            },
                                            {
                                                "box": {
                                                    "bgcolor": [ 1.0, 1.0, 1.0, 1.0 ],
                                                    "fontface": 0,
                                                    "fontname": "Arial",
                                                    "fontsize": 14.0,
                                                    "id": "c1-1",
                                                    "linecount": 13,
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
