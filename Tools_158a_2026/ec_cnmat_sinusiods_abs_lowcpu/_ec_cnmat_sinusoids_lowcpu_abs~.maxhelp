                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 25.0, 344.0, 455.0, 32.0 ],
                                                    "text": "Wire the message box correctly",
                                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
                                                }
                                            },
                                            {
                                                "box": {
                                                    "bgcolor": [ 1.0, 1.0, 1.0, 1.0 ],
                                                    "fontface": 0,
                                                    "fontname": "Arial",
                                                    "fontsize": 14.0,
                                                    "id": "c0-5",
                                                    "linecount": 8,
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 25.0, 388.0, 455.0, 206.0 ],
                                                    "text": "Connect outlet 14 to the LEFT inlet of an ordinary message box. The abstraction emits “set preset …”, which fills the box silently. Connect the box’s outlet to abstraction inlet 1. Clicking the filled box sends “preset …” and recalls it.\n\nThe help file’s p preset already provides this wiring. Save the parent patch, or copy the filled message box into your own patch, to retain the preset across closing/reopening.",
                                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
                                                }
                                            },
                                            {
                                                "box": {
                                                    "bgcolor": [ 1.0, 1.0, 1.0, 1.0 ],
                                                    "fontface": 1,
                                                    "fontname": "Arial",
                                                    "fontsize": 16.0,
                                                    "id": "c0-6",
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 25.0, 606.0, 455.0, 32.0 ],
                                                    "text": "Recall then trigger",
                                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
                                                }
                                            },
                                            {
                                                "box": {
                                                    "bgcolor": [ 1.0, 1.0, 1.0, 1.0 ],
                                                    "fontface": 0,
                                                    "fontname": "Arial",
                                                    "fontsize": 14.0,
                                                    "id": "c0-7",
                                                    "linecount": 3,
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 25.0, 650.0, 455.0, 88.0 ],
                                                    "text": "Recall briefly mutes output, cancels pending lane starts, restores the complete state, then restores gain. It restores loop switches but waits for trigger or a new keyboard note before playing.",
                                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
                                                }
                                            },
                                            {
                                                "box": {
                                                    "bgcolor": [ 0.94, 0.94, 0.94, 1 ],
                                                    "bgcolor2": [ 0.94, 0.94, 0.94, 1 ],
                                                    "bgfillcolor_autogradient": 0.0,
                                                    "bgfillcolor_color": [ 0.2, 0.2, 0.2, 1 ],
                                                    "bgfillcolor_color1": [ 0.94, 0.94, 0.94, 1 ],
                                                    "bgfillcolor_color2": [ 0.2, 0.2, 0.2, 1 ],
