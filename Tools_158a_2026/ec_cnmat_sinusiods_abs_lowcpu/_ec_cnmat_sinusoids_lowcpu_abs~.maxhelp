                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 520.0, 606.0, 455.0, 166.0 ],
                                                    "text": "Count 64 means 64 selected positions, not “all harmonics through 64 × f0.” Odd and prime modes can reach much higher frequencies. The frequency window and Nyquist filtering can reject high positions.\n\nShape and organ-stop recipes remain patterns over slider positions; changing the sequence changes their resulting timbre.",
                                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
                                                }
