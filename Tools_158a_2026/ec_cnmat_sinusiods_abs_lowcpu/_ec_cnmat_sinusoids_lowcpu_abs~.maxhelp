                                                    "fontsize": 16.0,
                                                    "id": "c0-0",
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 25.0, 120.0, 455.0, 32.0 ],
                                                    "text": "A ceiling, not a forced count",
                                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
                                                }
                                            },
                                            {
                                                "box": {
                                                    "bgcolor": [ 1.0, 1.0, 1.0, 1.0 ],
                                                    "fontface": 0,
                                                    "fontname": "Arial",
                                                    "fontsize": 14.0,
                                                    "id": "c0-1",
                                                    "linecount": 6,
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 25.0, 164.0, 455.0, 147.0 ],
                                                    "text": "RENDER LIMIT offers 64 / 128 / 256; default 128. SLIDER COUNT selects 2 up to that ceiling across the entire instrument.\n\n256 sliders + limit 128 → count becomes 128.\n48 sliders + limit 128 → count remains 48.\nRaise limit 128 → 256 → count remains unchanged.",
                                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
                                                }
                                            },
