                                                    "gradient": 1,
                                                    "id": "c0-5",
                                                    "maxclass": "message",
                                                    "numinlets": 2,
                                                    "numoutlets": 1,
                                                    "outlettype": [ "" ],
                                                    "patching_rect": [ 25.0, 384.0, 450.0, 30.0 ],
                                                    "text": "control Partial_Distribution 3",
                                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
                                                }
                                            },
                                            {
                                                "box": {
                                                    "bgcolor": [ 1.0, 1.0, 1.0, 1.0 ],
                                                    "fontface": 0,
                                                    "fontname": "Arial",
                                                    "fontsize": 14.0,
                                                    "id": "c0-6",
                                                    "linecount": 4,
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 25.0, 424.0, 455.0, 88.0 ],
                                                    "text": "With offset 1 and f0 = 100 Hz, slider 4 is 400 Hz in one-to-one mode, 600 Hz in even mode, 700 Hz in odd mode, and 500 Hz in prime mode. Its anchor uses the same multiplier. Primary detuning is applied afterward.",
                                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
                                                }
                                            },
                                            {
                                                "box": {
                                                    "bgcolor": [ 1.0, 1.0, 1.0, 1.0 ],
                                                    "fontface": 1,
                                                    "fontname": "Arial",
                                                    "fontsize": 16.0,
                                                    "id": "c0-7",
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 25.0, 524.0, 455.0, 32.0 ],
                                                    "text": "Offset 1 assigns f0 to slider 1",
                                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
                                                }
                                            },
                                            {
                                                "box": {
                                                    "bgcolor": [ 1.0, 1.0, 1.0, 1.0 ],
                                                    "fontface": 0,
                                                    "fontname": "Arial",
                                                    "fontsize": 14.0,
                                                    "id": "c0-8",
                                                    "linecount": 4,
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 25.0, 568.0, 455.0, 108.0 ],
                                                    "text": "The initial 1 in prime mode is deliberate; 1 is not a prime number. The prime sequence continues for all requested positions. An actual 1x f0 partial is protected from detune and micro-drift; its amplitude, global retuning, and filtering still apply. It is not forced to sound.",
                                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
                                                }
                                            },
                                            {
                                                "box": {
                                                    "bgcolor": [ 1.0, 1.0, 1.0, 1.0 ],
                                                    "fontface": 1,
                                                    "fontname": "Arial",
                                                    "fontsize": 16.0,
                                                    "id": "c1-0",
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 520.0, 120.0, 455.0, 32.0 ],
                                                    "text": "Partial Offset shifts the whole sequence",
                                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
                                                }
                                            },
                                            {
                                                "box": {
                                                    "bgcolor": [ 1.0, 1.0, 1.0, 1.0 ],
                                                    "fontface": 0,
                                                    "fontname": "Arial",
                                                    "fontsize": 14.0,
                                                    "id": "c1-1",
                                                    "linecount": 7,
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 520.0, 164.0, 455.0, 166.0 ],
                                                    "text": "Slider 1 starts at position N of the selected sequence. BASE FREQ stays at f0. Offset OFF uses N=1. At offset 5:\n\nOne-to-one: 5, 6, 7, 8…\nEven: 8, 10, 12, 14…\nOdd: 9, 11, 13, 15…\nPrime: 7, 11, 13, 17…",
                                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
                                                }
                                            },
                                            {
                                                "box": {
                                                    "bgcolor": [ 0.94, 0.94, 0.94, 1 ],
                                                    "bgcolor2": [ 0.94, 0.94, 0.94, 1 ],
                                                    "bgfillcolor_autogradient": 0.0,
                                                    "bgfillcolor_color": [ 0.2, 0.2, 0.2, 1 ],
                                                    "bgfillcolor_color1": [ 0.94, 0.94, 0.94, 1 ],
                                                    "bgfillcolor_color2": [ 0.2, 0.2, 0.2, 1 ],
                                                    "bgfillcolor_type": "color",
                                                    "fontsize": 13.0,
                                                    "gradient": 1,
