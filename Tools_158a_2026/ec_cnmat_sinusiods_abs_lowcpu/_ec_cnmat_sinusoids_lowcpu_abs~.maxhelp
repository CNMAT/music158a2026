                                    "patching_rect": [ 530.0, 276.0, 465.0, 21.0 ],
                                    "text": "Audio routing, group assignment, integration and isolation.",
                                    "textcolor": [ 0.08, 0.08, 0.08, 1.0 ]
                                }
                            },
                            {
                                "box": {
                                    "fontsize": 14.0,
                                    "id": "topic8",
