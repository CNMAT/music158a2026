":[20.0,712.0,805.0,40.0],"text":"File paths: morphbank write \"your full path/My Bank.json\"  |  morphbank read \"your full path/My Bank.json\"\nAn existing dump stages with: morphslot LETTER preset VERSION CHECKSUM CHUNKS… (complete dump).","fontname":"Arial","fontsize":11.5,"textcolor":[0.0,0.0,0.0,1.0],"presentation":1,"presentation_rect":[20.0,712.0,805.0,40.0]}},{"box":{"id":"h-buses","maxclass":"comment","numinlets":1,"numoutlets":0,"patching_rect":[20.0,757.0,805.0,38.0],"text":"Send direct or command-prefixed messages to Synth_Control_v23. V2_Synth_Command_v23 accepts direct commands.\nProgress: Synth_Morph_progress_v23. Completion: Synth_Morph_done_v23. Bank readback: Synth_MorphBank_state_v23.","fontname":"Arial","fontsize":11.5,"textcolor":[0.0,0.0,0.0,1.0],"presentation":1,"presentation_rect":[20.0,757.0,805.0,38.0]}},{"box":{"id":"h-cue","maxclass":"newobj","numinlets":0,"numoutlets":0,"patching_rect":[20.0,801.0,175.0,22.0],"text":"p V2_Cue_Morph_v23","presentation":1,"presentation_rect":[20.0,801.0,175.0,22.0],"hint":"Copy this CUE into a timed score. Input SLOT [SECONDS]; stop holds the sound.","annotation":"Copy this CUE into a timed score. Input SLOT [SECONDS]; stop holds the sound.","patcher":{"fileversion":1,"appversion":{"major":9,"minor":2,"revision":1,"architecture":"x64","modernui":1},"classnamespace":"box","rect":[100.0,100.0,620.0,350.0],"openinpresentation":1,"default_fontsize":12.0,"default_fontface":0,"default_fontname":"Arial","title":"v23 Morph CUE — seconds","bglocked":0,"autosave":0,"boxes":[{"box":{"id":"title","maxclass":"comment","numinlets":1,"numoutlets":0,"patching_rect":[20.0,15.0,570.0,26.0],"text":"MORPH CUE  |  SLOT [SECONDS]","fontname":"Arial","fontsize":18.0,"textcolor":[0.0,0.0,0.0,1.0],"presentation":1,"presentation_rect":[20.0,15.0,570.0,26.0],"fontface":1}},{"box":{"id":"note","maxclass":"comment","numinlets":1,"numoutlets":0,"patching_rect":[20.0,50.0,575.0,65.0],"text":"Send G 10 for an explicit ten-second morph, or G to use G’s stored seconds.\nFor a repeating list, use morphcue A B A D C F. Stop holds the current sound.\nAll referenced slots must be captured before the cue starts.","fontname":"Arial","fontsize":12.0,"textcolor":[0.0,0.0,0.0,1.0],"presentation":1,"presentation_rect":[20.0,50.0,575.0,65.0]}},{"box":{"id":"in","maxclass":"inlet","numinlets":0,"numoutlets":1,"patching_rect":[20.0,145.0,25.0,25.0]}},{"box":{"id":"route","maxclass":"newobj","numinlets":1,"numoutlets":2,"patching_rect":[20.0,185.0,85.0,22.0],"text":"route stop"}},{"box":{"id":"hold","maxclass":"message","numinlets":2,"numoutlets":1,"patching_rect":[140.0,185.0,85.0,22.0],"text":"morphstop","fontname":"Arial","fontsize":12.0,"textcolor":[0.0,0.0,0.0,1.0],"bgcolor":[0.81,0.9,0.93,1.0],"bgcolor2":[0.81,0.9,0.93,1.0],"gradient":0}},{"box":{"id":"prefix","maxclass":"newobj","numinlets":1,"numoutlets":1,"patching_rect":[20.0,225.0,120.0,22.0],"text":"prepend morphto"}},{"box":{"id":"send","maxclass":"newobj","numinlets":1,"numoutlets":0,"patching_rect":[20.0,265.0,180.0,22.0],"text":"send V2_Synth_Control_v23"}},{"box":{"id":"out","maxclass":"outlet","numinlets":1,"numoutlets":0,"patching_rect":[250.0,265.0,25.0,25.0]}},{"box":{"id":"ex0","maxclass":"message","numinlets":2,"numoutlets":1,"patching_rect":[20.0,125.0,80.0,22.0],"text":"G 10","fontname":"Arial","fontsize":12.0,"textcolor":[0.0,0.0,0.0,1.0],"bgcolor":[0.81,0.9,0.93,1.0],"bgcolor2":[0.81,0.9,0.93,1.0],"gradient":0,"presentation":1,"presentation_rect":[20.0,125.0,80.0,22.0],"hint":"Execute this CUE. It does not enable DSP or trigger an envelope.","annotation":"Execute this CUE. It does not enable DSP or trigger an envelope."}},{"box":{"id":"ex1","maxclass":"message","numinlets":2,"numoutlets":1,"patching_rect":[110.0,125.0,80.0,22.0],"text":"X 0.5","fontname":"Arial","fontsize":12.0,"textcolor":[0.0,0.0,0.0,1.0],"bgcolor":[0.81,0.9,0.93,1.0],"bgcolor2":[0.81,0.9,0.93,1.0],"gradient":0,"presentation":1,"presentation_rect":[110.0,125.0,80.0,22