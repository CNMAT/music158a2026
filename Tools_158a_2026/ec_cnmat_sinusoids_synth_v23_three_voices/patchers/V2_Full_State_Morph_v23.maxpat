{"patcher":{"fileversion":1,"appversion":{"major":9,"minor":2,"revision":1,"architecture":"x64","modernui":1},"classnamespace":"box","rect":[100.0,100.0,850.0,850.0],"openinpresentation":1,"default_fontsize":12.0,"default_fontface":0,"default_fontname":"Arial","title":"CNMAT Sinusoids v23 — MorphBank A–X","bglocked":0,"autosave":0,"boxes":[{"box":{"id":"h-title","maxclass":"comment","numinlets":1,"numoutlets":0,"patching_rect":[20.0,14.0,800.0,28.0],"text":"MORPHBANK A–X  |  24 FULL SOUNDS","fontname":"Arial","fontsize":20.0,"textcolor":[0.0,0.0,0.0,1.0],"presentation":1,"presentation_rect":[20.0,14.0,800.0,28.0],"fontface":1}},{"box":{"id":"h-text","maxclass":"comment","numinlets":1,"numoutlets":0,"patching_rect":[20.0,50.0,805.0,58.0],"text":"Set seconds, then capture: each slot retains its own time. morphto LETTER uses that saved time.\nAn explicit duration overrides only that transition. Morphs ease in and out over the first/last quarter.\nMorphing never starts DSP or triggers envelopes. Keep a sound running to hear the transition.","fontname":"Arial","fontsize":12.0,"textcolor":[0.0,0.0,0.0,1.0],"presentation":1,"presentation_rect":[20.0,50.0,805.0,58.0]}},{"box":{"id":"hm0","maxclass":"message","numinlets":2,"numoutlets":1,"patching_rect":[20.0,121.0,198.0,22.0],"text":"morphcapture A","fontname":"Arial","fontsize":12.0,"textcolor":[0.0,0.0,0.0,1.0],"bgcolor":[0.81,0.9,0.93,1.0],"bgcolor2":[0.81,0.9,0.93,1.0],"gradient":0,"presentation":1,"presentation_rect":[20.0,121.0,198.0,22.0],"hint":"Capture the current complete sound in A; other slots stay unchanged.","annotation":"Capture the current complete sound in A; other slots stay unchanged."}},{"box":{"id":"hc0","maxclass":"comment","numinlets":1,"numoutlets":0,"patching_rect":[228.0,121.0,600.0,24.0],"text":"Capture the current complete sound in A; other slots stay unchanged.","fontname":"Arial","fontsize":11.5,"textcolor":[0.0,0.0,0.0,1.0],"presentation":1,"presentation_rect":[228.0,121.0,600.0,24.0]}},{"box"