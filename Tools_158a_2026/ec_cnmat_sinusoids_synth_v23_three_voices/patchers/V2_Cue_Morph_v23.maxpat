,"maxclass":"message","numinlets":2,"numoutlets":1,"patching_rect":[20.0,125.0,80.0,22.0],"text":"G 10","fontname":"Arial","fontsize":12.0,"textcolor":[0.0,0.0,0.0,1.0],"bgcolor":[0.81,0.9,0.93,1.0],"bgcolor2":[0.81,0.9,0.93,1.0],"gradient":0,"presentation":1,"presentation_rect":[20.0,125.0,80.0,22.0],"hint":"Execute this CUE. It does not enable DSP or trigger an envelope.","annotation":"Execute this CUE. It does not enable DSP or trigger an envelope."}},{"box":{"id":"ex1","maxclass":"message","numinlets":2,"numoutlets":1,"patching_rect":[110.0,125.0,80.0,22.0],"text":"X 0.5","fontname":"Arial","fontsize":12.0,"textcolor":[0.0,0.0,0.0,1.0],"bgcolor":[0.81,0.9,0.93,1.0],"bgcolor2":[0.81,0.9,0.93,1.0],"gradient":0,"presentation":1,"presentation_rect":[110.0,125.0,80.0,22.0],"hint":"Execute this CUE. It does not enable DSP or trigger an envelope.","annotation":"Execute this CUE. It does not enable DSP or trigger an envelope."}},{"box":{"id":"ex2","maxclass":"message","numinlets":2,"numoutlets":1,"patching_rect":[200.0,125.0,80.0,22.0],"text":"stop","fontname":"Arial","fontsize":12.0,"textcolor":[0.0,0.0,0.0,1.0],"bgcolor":[0.81,0.9,0.93,1.0],"bgcolor2":[0.81,0.9,0.93,1.0],"gradient":0,"presentation":1,"presentation_rect":[200.0,125.0,80.0,22.0],"hint":"Execute this CUE. It does not enable DSP or trigger an envelope.","annotation":"Execute this CUE. It does not enable DSP or trigger an envelope."}},{"box":{"id":"monitor-note","maxclass":"comment","numinlets":1,"numoutlets":0,"patching_rect":[20.0,215.0,575.0,50.0],"text":"The outlet reports the sent command; it is a monitor, not a second send.\nFor arbitrary synth commands, use send V2_Synth_Control_v23 or Synth_Command_v23.","fontname":"Arial","fontsize":12.0,"textcolor":[0.0,0.0,0.0,1.0],"presentation":1,"presentation_rect":[20.0,215.0,575.0,50.0]}},{"box":{"id":"mb2-loop-example","maxclass":"message","numinlets":2,"numoutlets":1,"patching_rect":[20.0,165.0,280.0,22.0],"text":"morphcue A B A D C F","outlettype":[""],"