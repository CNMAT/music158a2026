rial","bgcolor2":[0.8,0.87,0.93,1.0],"textcolor2":[0.0,0.0,0.0,1.0],"gradient":0}},{"box":{"id":"tut-19","maxclass":"comment","numinlets":1,"numoutlets":0,"patching_rect":[184.0,140.0,364.0,17.0],"text":"Set the base frequency one octave higher.","presentation":1,"presentation_rect":[184.0,140.0,364.0,17.0],"fontsize":11.5,"textcolor":[0.09,0.12,0.15,1.0],"fontface":0,"fontname":"Arial","linecount":1}},{"box":{"id":"tut-20","maxclass":"message","numinlets":2,"numoutlets":1,"patching_rect":[12.0,164.0,52.0,22.0],"text":"110 Hz","presentation":1,"presentation_rect":[12.0,164.0,52.0,22.0],"outlettype":[""],"fontsize":12.0,"bgcolor":[0.8,0.87,0.93,1.0],"textcolor":[0.0,0.0,0.0,1.0],"hint":"Return to the starting pitch. Sends: control Source_Base_Hz 110","annotation":"Return to the starting pitch. Sends: control Source_Base_Hz 110","fontname":"Arial","bgcolor2":[0.8,0.87,0.93,1.0],"textcolor2":[0.0,0.0,0.0,1.0],"gradient":0}},{"box":{"id":"tut-24","maxclass":"comment","numinlets":1,"numoutlets":0,"patching_rect":[184.0,166.0,364.0,17.0],"text":"Return to the starting pitch.","presentation":1,"presentation_rect":[184.0,166.0,364.0,17.0],"fontsize":11.5,"textcolor":[0.09,0.12,0.15,1.0],"fontface":0,"fontname":"Arial","linecount":1}},{"box":{"id":"tut-25","maxclass":"message","numinlets":2,"numoutlets":1,"patching_rect":[12.0,190.0,85.0,22.0],"text":"Trigger again","presentation":1,"presentation_rect":[12.0,190.0,85.0,22.0],"outlettype":[""],"fontsize":12.0,"bgcolor":[0.8,0.87,0.93,1.0],"textcolor":[0.0,0.0,0.0,1.0],"hint":"Play the current envelope again. Sends: trigger","annotation":"Play the current envelope again. Sends: trigger","fontname":"Arial","bgcolor2":[0.8,0.87,0.93,1.0],"textcolor2":[0.0,0.0,0.0,1.0],"gradient":0}},{"box":{"id":"tut-29","maxclass":"comment","numinlets":1,"numoutlets":0,"patching_rect":[184.0,192.0,364.0,17.0],"text":"Play the current envelope again.","presentation":1,"presentation_rect":[184.0,192.0,364.0,17.0],"fontsize":11.5,"textcolor":[0.09,0.12,0.15,1.0],"fontface":0,"fontname":"Arial","linecount":1}},{"box":{"id":"tut-30","maxclass":"comment","numinlets":1,"numoutlets":0,"patching_rect":[12.0,219.0,536.0,16.0],"text":"LISTEN Enable DSP manually. Prepare uses outputs 1–2 at −24 dB; raise MASTER slowly.","presentation":1,"presentation_rect":[12.0,219.0,536.0,16.0],"fontsize":11.0,"textcolor":[0.09,0.12,0.15,1.0],"hint":"LISTEN  Enable the synth’s DAC manually, then click Listen. Prepare sets DAC gain to −24 dB and routes to two outputs. Raise the MASTER slowly if needed.","annotation":"LISTEN  Enable the synth’s DAC manually, then click Listen. Prepare sets DAC gain to −24 dB and routes to two outputs. Raise the MASTER slowly if needed.","fontface":0,"fontname":"Arial","linecount":1}},{"box":{"id":"tut-31","maxclass":"comment","numinlets":1,"numoutlets":0,"patching_rect":[12.0,238.0,536.0,16.0],"text":"CHECK No sound? Check DSP, outputs, global gain, partial levels and the envelope.","presentation":1,"presentation_rect":[12.0,238.0,536.0,16.0],"fontsize":11.0,"textcolor":[0.09,0.12,0.15,1.0],"hint":"NOTICE  No sound? Check DAC, hardware outputs 1–2, global gain, partial amplitude and a nonzero envelope. The tutorial never turns DSP on.","annotation":"NOTICE  No sound? Check DAC, hardware outputs 1–2, global gain, partial amplitude and a nonzero envelope. The tutorial never turns DSP on.","fontface":0,"fontname":"Arial","linecount":1}},{"box":{"id":"tut-32","maxclass":"comment","numinlets":1,"numoutlets":0,"patching_rect":[12.0,257.0,536.0,16.0],"text":"TRY Change BASE FREQ. The single sine wave stays simple.","presentation":1,"presentation_rect":[12.0,257.0,536.0,16.0],"fontsize":11.0,"textcolor":[0.09,0.12,0.15,1.0],"hint":"TRY NEXT  Change only the base frequency. The sound stays simple.","annotation":"TRY NEXT  Change only the base frequency. The sound stays simple.","fontface":0,"fontname":"Arial","linecount":1}},{"box":{"id":"tut-33","maxclass":"message","numinlets":2,"numoutlets":1,"patching_rec