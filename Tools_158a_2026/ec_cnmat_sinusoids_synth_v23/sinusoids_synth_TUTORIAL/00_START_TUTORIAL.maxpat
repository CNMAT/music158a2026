          "patching_rect": [
            12.0,
            40.0,
            536.0,
            45.0
          ],
          "fontsize": 12.0,
          "fontname": "Arial",
          "text": "This additive synth uses twelve CNMAT sinusoids~ oscillator banks to combine sine waves. Up to\n256 partial slots each have a primary tone and a harmonic-anchor partner. Spectral shapes,\ndetuning, drift, twelve independent envelopes, spatial routing and an automixer shape the sound.",
          "presentation": 1,
          "presentation_rect": [
            12.0,
            40.0,
            536.0,
            45.0
          ],
          "textcolor": [
            0.09,
            0.12,
            0.15,
            1.0
          ],
          "fontface": 0,
          "linecount": 3
        }
      },
      {
        "box": {
          "id": "overview-instructions",
          "maxclass": "comment",
          "numinlets": 1,
          "numoutlets": 0,
          "patching_rect": [
            12.0,
            90.0,
            536.0,
            29.0
          ],
          "fontsize": 11.0,
          "fontname": "Arial",
          "presentation": 1,
          "presentation_rect": [
            12.0,
            90.0,
            536.0,
            29.0
          ],
          "textcolor": [
            0.09,
            0.12,
            0.15,
            1.0
          ],
          "text": "Open the synth normally, then double-click a lesson. Use ← / → in a lesson to navigate. Opening a lesson\nnever starts DSP.",
          "fontface": 0,
          "linecount": 2
        }
      },
