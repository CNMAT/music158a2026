          "textcolor": [
            0.09,
            0.12,
            0.15,
            1.0
          ],
          "text": "Prepare replaces the live spectrum, including hidden slots. Save a sound with dump first. It leaves global\ngain at zero; Listen starts the example.",
          "fontface": 0,
          "linecount": 2
        }
