<group>                  // Shared defaults for this group of regions.
lokey=48                 // Lowest triggering MIDI note: 48 (inclusive).
hikey=84                 // Highest triggering MIDI note: 84 (inclusive).
pitch_keycenter=60       // MIDI 60 plays at the sample's original pitch.
loop_mode=no_loop        // Play without looping; note release starts a fade.
ampeg_release=0.15       // Fade after note release: 0.15 seconds.
amp_veltrack=0           // Disable velocity-based amplitude scaling.
volume=-9                // Set sample gain offset to -9 dB.
<region>                 // Begin a playable region; inherit shared settings.
trigger=first            // Start on note-on when no other key is held.
sample=samples/soft_C4.wav // Load soft C4 WAV; path relative to this SFZ.
<region>                 // Begin a playable region; inherit shared settings.
trigger=legato           // Start on note-on while another key is held.
sample=samples/bright_C4.wav // Load bright C4 WAV; path relative to this SFZ.
