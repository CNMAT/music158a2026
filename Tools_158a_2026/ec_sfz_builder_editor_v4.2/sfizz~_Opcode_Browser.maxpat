                                    "varname": "index_505_1"
                                }
                            },
                            {
                                "box": {
                                    "bgcolor": [ 0.967, 0.965, 0.95, 1.0 ],
                                    "fontface": 0,
                                    "fontname": "Arial",
                                    "fontsize": 13.0,
                                    "id": "obj-1667",
                                    "linecount": 3,
                                    "maxclass": "comment",
                                    "numinlets": 1,
                                    "numoutlets": 0,
                                    "patching_rect": [ 720.0, 42536.0, 535.0, 50.0 ],
                                    "text": "In <sample>, names embedded sample data so a region can refer to it with sample=.\nDependencies: name and base64data must appear together in <sample>; a region must\nreference exactly the same sample name. The example embeds a short valid mono WAV.",
                                    "textcolor": [ 0.12, 0.18, 0.24, 1.0 ],
