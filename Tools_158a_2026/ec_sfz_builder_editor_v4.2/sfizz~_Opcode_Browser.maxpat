                    "id": "menu-19",
                    "items": [ "Choose an opcode…", ",", "Sets LFO N frequency.  [lfoN_freq]", ",", "Sets CC X control of LFO N frequency.  [lfoN_freq_onccX]", ",", "Smooths CC X changes to LFO N frequency.  [lfoN_freq_smoothccX]", ",", "Quantizes CC X changes to LFO N frequency; 0 means continuous.  [lfoN_freq_stepccX]", ",", "Sets LFO N start delay.  [lfoN_delay]", ",", "Sets CC X control of LFO N start delay.  [lfoN_delay_onccX]", ",", "Sets LFO N fade-in time.  [lfoN_fade]", ",", "Sets CC X control of LFO N fade-in time.  [lfoN_fade_onccX]", ",", "Sets LFO N initial phase.  [lfoN_phase]", ",", "Sets CC X control of LFO N initial phase.  [lfoN_phase_onccX]", ",", "Sets LFO N waveform.  [lfoN_wave]", ",", "Sets LFO N subwave X waveform.  [lfoN_waveX]", ",", "Sets LFO N step count.  [lfoN_steps]", ",", "Sets LFO N step X value.  [lfoN_stepX]", ",", "Sets LFO N modulation depth for gain in dB.  [lfoN_volume]", ",", "Sets CC X control of LFO N modulation depth for gain in dB.  [lfoN_volume_onccX]", ",", "Smooths CC X changes to LFO N modulation depth for gain in dB.  [lfoN_volume_smoothccX]", ",", "Quantizes CC X changes to LFO N modulation depth for gain in dB; 0 means continuous.  [lfoN_volume_stepccX]", ",", "Sets LFO N modulation depth for linear amplitude.  [lfoN_amplitude]", ",", "Sets CC X control of LFO N modulation depth for linear amplitude.  [lfoN_amplitude_onccX]", ",", "Smooths CC X changes to LFO N modulation depth for linear amplitude.  [lfoN_amplitude_smoothccX]", ",", "Quantizes CC X changes to LFO N modulation depth for linear amplitude; 0 means continuous.  [lfoN_amplitude_stepccX]", ",", "Sets LFO N modulation depth for pan position.  [lfoN_pan]", ",", "Sets CC X control of LFO N modulation depth for pan position.  [lfoN_pan_onccX]", ",", "Smooths CC X changes to LFO N modulation depth for pan position.  [lfoN_pan_smoothccX]", ",", "Quantizes CC X changes to LFO N modulation depth for pan position; 0 means continuous.  [lfoN_pan_stepccX]", ",", "Sets LFO N modulation depth for stereo width.  [lfoN_width]", ",", "Sets CC X control of LFO N modulation depth for stereo width.  [lfoN_width_onccX]", ",", "Smooths CC X changes to LFO N modulation depth for stereo width.  [lfoN_width_smoothccX]", ",", "Quantizes CC X changes to LFO N modulation depth for stereo width; 0 means continuous.  [lfoN_width_stepccX]", ",", "Sets LFO N modulation depth for pitch.  [lfoN_pitch]", ",", "Selects the response curve for CC X changes to LFO N modulation depth for pitch.  [lfoN_pitch_curveccX]", ",", "Sets CC X control of LFO N modulation depth for pitch.  [lfoN_pitch_onccX]", ",", "Smooths CC X changes to LFO N modulation depth for pitch.  [lfoN_pitch_smoothccX]", ",", "Quantizes CC X changes to LFO N modulation depth for pitch; 0 means continuous.  [lfoN_pitch_stepccX]", ",", "Sets LFO N modulation depth for filter cutoff.  [lfoN_cutoff]", ",", "Sets LFO N modulation depth for filter 2 cutoff.  [lfoN_cutoff2]", ",", "Sets CC X control of LFO N modulation depth for filter 2 cutoff.  [lfoN_cutoff2_onccX]", ",", "Smooths CC X changes to LFO N modulation depth for filter 2 cutoff.  [lfoN_cutoff2_smoothccX]", ",", "Quantizes CC X changes to LFO N modulation depth for filter 2 cutoff; 0 means continuous.  [lfoN_cutoff2_stepccX]", ",", "Sets CC X control of LFO N modulation depth for filter cutoff.  [lfoN_cutoff_onccX]", ",", "Smooths CC X changes to LFO N modulation depth for filter cutoff.  [lfoN_cutoff_smoothccX]", ",", "Quantizes CC X changes to LFO N modulation depth for filter cutoff; 0 means continuous.  [lfoN_cutoff_stepccX]", ",", "Sets LFO N modulation depth for filter resonance.  [lfoN_resonance]", ",", "Sets LFO N modulation depth for filter 2 resonance.  [lfoN_resonance2]", ",", "Sets CC X control of LFO N modulation depth for filter 2 resonance.  [lfoN_resonance2_onccX]", ",", "Smooths CC X changes to LFO N modulation depth for filter 2 resonance.  [lfoN_resonance2_smoothccX]", ",", "Quantizes CC X changes to LFO N modulation depth for filter 2 resonance; 0 means continuous.  [lfoN_resonance2_stepccX]", ",", "Sets CC X control of LFO N modulation depth for filter resonance.  [lfoN_resonance_onccX]", ",", "Smooths CC X changes to LFO N modulation depth for filter resonance.  [lfoN_resonance_smoothccX]", ",", "Quantizes CC X changes to LFO N modulation depth for filter resonance; 0 means continuous.  [lfoN_resonance_stepccX]", ",", "Sets LFO N modulation depth for EQ X frequency.  [lfoN_eqXfreq]", ",", "Sets CC Y control of LFO N modulation depth for EQ X frequency.  [lfoN_eqXfreq_onccY]", ",", "Smooths CC Y changes to LFO N modulation depth for EQ X frequency.  [lfoN_eqXfreq_smoothccY]", ",", "Quantizes CC Y changes to LFO N modulation depth for EQ X frequency; 0 means continuous.  [lfoN_eqXfreq_stepccY]", ",", "Sets LFO N modulation depth for EQ X bandwidth.  [lfoN_eqXbw]", ",", "Sets CC Y control of LFO N modulation depth for EQ X bandwidth.  [lfoN_eqXbw_onccY]", ",", "Smooths CC Y changes to LFO N modulation depth for EQ X bandwidth.  [lfoN_eqXbw_smoothccY]", ",", "Quantizes CC Y changes to LFO N modulation depth for EQ X bandwidth; 0 means continuous.  [lfoN_eqXbw_stepccY]", ",", "Sets LFO N modulation depth for EQ X gain.  [lfoN_eqXgain]", ",", "Sets CC Y control of LFO N modulation depth for EQ X gain.  [lfoN_eqXgain_onccY]", ",", "Smooths CC Y changes to LFO N modulation depth for EQ X gain.  [lfoN_eqXgain_smoothccY]", ",", "Quantizes CC Y changes to LFO N modulation depth for EQ X gain; 0 means continuous.  [lfoN_eqXgain_stepccY]", ",", "Sets LFO N subwave 1 vertical offset.  [lfoN_offset]", ",", "Sets LFO N subwave X vertical offset.  [lfoN_offsetX]", ",", "Sets LFO N subwave 1 frequency ratio.  [lfoN_ratio]", ",", "Sets LFO N subwave X frequency ratio.  [lfoN_ratioX]", ",", "Sets LFO N subwave 1 amplitude scale.  [lfoN_scale]", ",", "Sets LFO N subwave X amplitude scale.  [lfoN_scaleX]", ",", "Sets LFO N modulation depth for filter X gain.  [lfoN_filXgain]", ",", "Sets CC 