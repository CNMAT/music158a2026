						"<region> // delay= // waits this long after a trigger before starting the sample.",
						",",
						"<region> // delay_ccN= // adds a CC-scaled delay before the sample starts.",
						",",
						"<region> // delay_onccN= // adds a CC-scaled delay before the sample starts.",
						",",
						"<region> // delay_random= // adds a random start delay from zero up to this amount.",
						",",
						"<region> // end= // sets the last sample-frame position used for playback; 0 disables playback.",
						",",
						"<region> // loop_count= // limits additional loop repetitions; 0 prevents repeats; while omitting the opcode leaves looping unlimited.",
						",",
						"<region> // loop_crossfade= // sets the crossfade duration across the loop boundary; effective length is sample-dependent.",
						",",
						"<region> // loop_end= // sets the loop end position in sample frames.",
						",",
						"<region> // loopend= // sets the loop end position in sample frames.",
						",",
						"<region> // loop_lengthccN= // adds a CC-scaled offset to the loop end point (engine maps this to loop_end_onccN).",
						",",
						"<region> // loop_length_onccN= // adds a CC-scaled offset to the loop end point (engine maps this to loop_end_onccN).",
						",",
						"<region> // loop_mode= // selects unlooped; note-off-ignoring one-shot; continuous-loop or held-note-loop playback.",
						",",
