                                    "varname": "index_506_1"
                                }
                            },
                            {
                                "box": {
                                    "bgcolor": [ 0.925, 0.939, 0.934, 1.0 ],
                                    "fontface": 0,
                                    "fontname": "Arial",
                                    "fontsize": 13.0,
                                    "id": "obj-1670",
                                    "linecount": 3,
                                    "maxclass": "comment",
                                    "numinlets": 1,
                                    "numoutlets": 0,
                                    "patching_rect": [ 720.0, 42601.0, 535.0, 50.0 ],
                                    "text": "In <sample>, embeds a base64 audio file; bare data= is not decoded by this engine.\nDependencies: name and base64data must appear together in <sample>; a region must\nreference exactly the same sample name. The example embeds a short valid mono WAV.",
                                    "textcolor": [ 0.12, 0.18, 0.24, 1.0 ],
                                    "varname": "index_506_2"
                                }
                            },
                            {
