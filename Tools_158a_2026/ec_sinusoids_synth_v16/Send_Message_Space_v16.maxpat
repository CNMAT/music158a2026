,22],"text":"prepend set"}},{"box":{"id":"unpack","maxclass":"newobj","numinlets":1,"numoutlets":2,"outlettype":["float","float"],"patching_rect":[165,205,115,22],"text":"unpack f f"}},{"box":{"id":"value-limit","maxclass":"newobj","numinlets":3,"numoutlets":1,"outlettype":[""],"patching_rect":[165,250,180,22],"text":"clip 1 23000"}},{"box":{"id":"time-limit","maxclass":"newobj","numinlets":3,"numoutlets":1,"outlettype":[""],"patching_rect":[165,290,170,22],"text":"clip 0. 3600000."}},{"box":{"id":"target-time","maxclass":"newobj","numinlets":2,"numoutlets":1,"outlettype":[""],"patching_rect":[165,335,130,22],"text":"pack f 20."}},{"box":{"id":"ramp","maxclass":"newobj","numinlets":3,"numoutlets":2,"outlettype":["","bang"],"patching_rect":[165,385,180,22],"text":"line 55. 5"}},{"box":{"id":"readback","maxclass":"newobj","numinlets":0,"numoutlets":1,"outlettype":[""],"patching_rect":[425,155,480,22],"text":"receive Source_Base_Hz_state_v16"}},{"box":{"id":"ramp-note","linecount":2,"maxclass":"comment","numinlets":1,"numoutlets":0,"patching_rect":[425,320,470,60],"text":"5 ms line grain. Current engine readback is cached without output. Each cue starts from the last known value. Keep one active writer per variable."}},{"box":{"id":"name","maxclass":"newobj","numinlets":1,"numoutlets":1,"outlettype":[""],"patching_rect":[30,570,350,22],"text":"prepend Source_Base_Hz_v16"}},{"box":{"id":"fan","maxclass":"newobj","numinlets":1,"numoutlets":3,"outlettype":["","",""],"patching_rect":[30,606,80,22],"text":"t l l l"}},{"box":{"id":"display-set","maxclass":"newobj","numinlets":1,"numoutlets":1,"outlettype":[""],"patching_rect":[425,606,90,22],"text":"prepend set"}},{"box":{"id":"display","maxclass":"message","numinlets":2,"numoutlets":1,"outlettype":[""],"patching_rect":[425,645,480,22],"text":"Source_Base_Hz_v16 — last message appears here"}},{"box":{"id":"strip-name","maxclass":"newobj","numinlets":2,"numoutlets":2,"outlettype":["",""],"patching_rect":[30,645,350,22],"text"