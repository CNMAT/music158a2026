{"box":{"id":"category-note10","maxclass":"comment","numinlets":1,"numoutlets":0,"patching_rect":[33,1025,525,20],"text":"1 copyable cues"}},{"box":{"id":"how-messages-work","maxclass":"newobj","numinlets":0,"numoutlets":0,"patcher":{"fileversion":1,"appversion":{"major":9,"minor":1,"revision":5,"architecture":"x64","modernui":1},"classnamespace":"box","rect":[134,172,1080,740],"boxes":[{"box":{"id":"title","maxclass":"comment","numinlets":1,"numoutlets":0,"patching_rect":[25,15,1000,20],"text":"HOW TO MESSAGE THE ENGINE — three copyable patterns"}},{"box":{"id":"intro","maxclass":"comment","numinlets":1,"numoutlets":0,"patching_rect":[25,55,1000,20],"text":"Open the v16 engine first. These examples send only when clicked. Select the complete connected example when copying; for a portable ramp, copy the entire p Cue object."}},{"box":{"id":"a","maxclass":"comment","numinlets":1,"numoutlets":0,"patching_rect":[25,130,1000,20],"text":"1. Immediate payload → named destination. This is the minimum message path."}},{"box":{"id":"value","maxclass":"message","numinlets":2,"numoutlets":1,"outlettype":[""],"patching_rect":[25,175,85,22],"text":"110."}},{"box":{"id":"send","maxclass":"newobj","numinlets":1,"numoutlets":0,"patching_rect":[190,175,260,22],"text":"send Source_Base_Hz_v16"}},{"box":{"id":"b","maxclass":"comment","numinlets":1,"numoutlets":0,"patching_rect":[25,250,1000,20],"text":"2. Visible named command → strip its name → forward the numeric payload."}},{"box":{"id":"named","maxclass":"message","numinlets":2,"numoutlets":1,"outlettype":[""],"patching_rect":[25,300,265,22],"text":"Source_Base_Hz_v16 110."}},{"box":{"id":"route","maxclass":"newobj","numinlets":2,"numoutlets":2,"outlettype":["",""],"patching_rect":[325,300,260,22],"text":"route Source_Base_Hz_v16"}},{"box":{"id":"forward","maxclass":"newobj","numinlets":1,"numoutlets":0,"patching_rect":[625,300,310,22],"text":"forward Source_Base_Hz_v16"}},{"box":{"id":"c","maxclass":"comment","numinlets":1,"numou