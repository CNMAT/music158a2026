{"patcher":{"fileversion":1,"appversion":{"major":9,"minor":1,"revision":5,"architecture":"x64","modernui":1},"classnamespace":"box","rect":[34,100,1401,782],"boxes":[{"box":{"bgcolor":[1,0.729,0.039,1],"bgcolor2":[0.2,0.2,0.2,1],"bgfillcolor_angle":270,"bgfillcolor_autogradient":0,"bgfillcolor_color":[1,0.729,0.039,1],"bgfillcolor_color1":[1,0.729,0.039,1],"bgfillcolor_color2":[0.2,0.2,0.2,1],"bgfillcolor_proportion":0.5,"bgfillcolor_type":"gradient","gradient":1,"id":"obj-83","maxclass":"message","numinlets":2,"numoutlets":1,"outlettype":[""],"patching_rect":[254.5,198,72,22],"text":"220. 10000."}},{"box":{"bgcolor":[1,0.729,0.039,1],"bgcolor2":[0.2,0.2,0.2,1],"bgfillcolor_angle":270,"bgfillcolor_autogradient":0,"bgfillcolor_color":[1,0.729,0.039,1],"bgfillcolor_color1":[1,0.729,0.039,1],"bgfillcolor_color2":[0.2,0.2,0.2,1],"bgfillcolor_proportion":0.5,"bgfillcolor_type":"gradient","gradient":1,"id":"obj-82","maxclass":"message","numinlets":2,"numoutlets":1,"outlettype":[""],"patching_rect":[268.5,222,72,22],"text":"27.5 10000."}},{"box":{"bgcolor":[1,0.729,0.039,1],"bgcolor2":[0.2,0.2,0.2,1],"bgfillcolor_angle":270,"bgfillcolor_autogradient":0,"bgfillcolor_color":[1,0.729,0.039,1],"bgfillcolor_color1":[1,0.729,0.039,1],"bgfillcolor_color2":[0.2,0.2,0.2,1],"bgfillcolor_proportion":0.5,"bgfillcolor_type":"gradient","gradient":1,"id":"obj-61","maxclass":"message","numinlets":2,"numoutlets":1,"outlettype":[""],"patching_rect":[676,193,29.5,22],"text":"0"}},{"box":{"bgcolor":[1,0.729,0.039,1],"format":6,"id":"obj-62","maxclass":"flonum","numinlets":1,"numoutlets":2,"outlettype":["","bang"],"parameter_enable":0,"patching_rect":[676,222,50,22]}},{"box":{"bgcolor":[1,0.729,0.039,1],"bgcolor2":[0.2,0.2,0.2,1],"bgfillcolor_angle":270,"bgfillcolor_autogradient":0,"bgfillcolor_color":[1,0.729,0.039,1],"bgfillcolor_color1":[1,0.729,0.039,1],"bgfillcolor_color2":[0.2,0.2,0.2,1],"bgfillcolor_proportion":0.5,"bgfillcolor_type":"gradient","gradient":1,"id":"obj-2","maxclass":"message","numinlets":2,"numoutlets":1,"outlettype":[""],"patching_rect":[81,380,45,22],"text":"0. 500."}},{"box":{"bgcolor":[1,0.729,0.039,1],"bgcolor2":[0.2,0.2,0.2,1],"bgfillcolor_angle":270,"bgfillcolor_autogradient":0,"bgfillcolor_color":[1,0.729,0.039,1],"bgfillcolor_color1":[1,0.729,0.039,1],"bgfillcolor_color2":[0.2,0.2,0.2,1],"bgfillcolor_proportion":0.5,"bgfillcolor_type":"gradient","gradient":1,"id":"obj-63","maxclass":"message","numinlets":2,"numoutlets":1,"outlettype":[""],"patching_rect":[922,263,29.5,22],"text":"1"}},{"box":{"bgcolor":[0.7215686274509804,0.6941176470588235,0.6235294117647059,1],"id":"retuning-help14","maxclass":"newobj","numinlets":0,"numoutlets":0,"patcher":{"fileversion":1,"appversion":{"major":9,"minor":1,"revision":5,"architecture":"x64","modernui":1},"classnamespace":"box","rect":[100,100,880,730],"boxes":[{"box":{"fontsize":20,"id":"help0","maxclass":"comment","numinlets":1,"numoutlets":0,"patching_rect":[20,30,825,29],"text":"RETUNING MODES — HOW TO USE THEM","textcolor":[0.1,0.1,0.1,1]}},{"box":{"fontsize":13,"id":"help1","linecount":3,"maxclass":"comment","numinlets":1,"numoutlets":0,"patching_rect":[20,78,825,50],"text":"SOURCE BASE Hz defines the source model. Changing it resets TARGET BASE to that value and retunes over RETUNE MS. CURRENT BASE shows the glide position. With Source 27.5, no extra transforms, and zero inharmonicity, the harmonic series is 27.5, 55, 82.5, 110… Hz.","textcolor":[0.1,0.1,0.1,1]}},{"box":{"fontsize":13,"id":"help2","linecount":3,"maxclass":"comment","numinlets":1,"numoutlets":0,"patching_rect":[20,182,829,50],"text":"1. REBUILD BASE / ERB DRIFT: The generator rebuilds each partial using CURRENT BASE and the existing inharmonicity sliders. The ERB bandwidth is recalculated at the new frequencies, so an inharmonic spectrum changes its relative spacing. For exact harmonics with zero drift: Source 110 → Target 220 doubles every frequency.","textcolor":[0.1,0.1,0.1,1]}},{"box":{"fontsize":13,"id":"help3","linecount":3,"maxclass":"comment","numinlets":1,"numoutlets":0,"patching_rect":[20,286,825,50],"text":"2. RATIO TRANSPOSE / FIXED SPECTRUM: The generator stays at SOURCE BASE. Every stored source frequency is multiplied by CURRENT BASE / SOURCE BASE. Source 110 → Target 220 gives ratio 2; Target 27.5 gives ratio 0.25. Frequency ratios and relative inharmonicity are preserved.","textcolor":[0.1,0.1,0.1,1]}},{"box":{"fontsize":13,"id":"help4","linecount":3,"maxclass":"comment","numinlets":1,"numoutlets":0,"patching_rect":[20,390,825,50],"text":"3. ADDITIVE Hz SHIFT: The generator stays at SOURCE BASE. Every frequency receives CURRENT BASE − SOURCE BASE Hz. Source 110 → Target 220 shifts 110, 220, 330 to 220, 330, 440 Hz. This changes frequency ratios and does not preserve a harmonic series rooted at the target.","textcolor":[0.1,0.1,0.1,1]}},{"box":{"fontsize":13,"id":"help5","linecount":2,"maxclass":"comment","numinlets":1,"numoutlets":0,"patching_rect":[20,494,825,36],"text":"GLIDE: Rebuild and ratio modes use a geometric pitch glide; additive uses a linear-Hz glide. RETUNE MS 0 applies immediately. Changing RETUNE MS affects the next target request. A new target starts from the elapsed position of the current glide.","textcolor":[0.1,0.1,0.1,1]}},{"box":{"fontsize":13,"id":"help6","linecount":2,"maxclass":"comment","numinlets":1,"numoutlets":0,"patching_rect":[20,586,825,36],"text":"POST TRANSFORMS: retuned frequency = source × retuning ratio × 2^(semitones/12 + cents/1200) + retuning shift + extra shift Hz. Model gain follows. Minimum / maximum Hz and the sample-rate safety limit filter the result; optional clusters combine nearby frequencies.","textcolor":[0.1,0.1,0.1,1]}},{"box":{"fontsize":13,"id":"help7","linecount":3,"maxclass":"comment","numinlets":1,"numoutlets":0,"patching_rect":[20,690,825,50],"text":"BYPASS: skips ratio/additive retuning, semitones, cents, extra shift, gain and clusters. Rebuild-mode base changes still apply. Safety filtering remains active. To audition 27.5 Hz directly: zero inharmonicity, nonzero partial-1 amplitude, gain > 0, low cutoff ≤ 27.5, bypass off and extra transforms at zero. Speakers may reproduce 27.5 Hz weakly.","textcolor":[0.1,0.1,0.1,1]}}],"lines":[],"bgcolor":[0.92,0.92,0.92,1]},"patching_rect":[66,235,167,22],"presentation":1,"presentation_rect":[375,716,210,22],"saved_object_attributes":{"locked_bgcolor":[0.92,0.92,0.92,1]},"text":"p Retuning_Modes_Help_v16"}},{"box":{"bgcolor":[1,0.729,0.039,1],"id":"obj-64","maxclass":"comment","numinlets":1,"numoutlets":0,"patching_rect":[32,210,206,20],"text":"Retuning mode 0/1/2 | INTEGER 0–2"}},{"box":{"bgcolor":[1,0.729,0.039,1],"bgcolor2":[0.2,0.2,0.2,1],"bgfillcolor_angle":270,"bgfillcolor_autogradient":0,"bgfillcolor_color":[1,0.729,0.039,1],"bgfillcolor_color1":[1,0.729,0.039,1],"bgfillcolor_color2":[0.2,0.2,0.2,1],"bgfillcolor_proportion":0.5,"bgfillcolor_type":"gradient","gradient":1,"id":"obj-65","maxclass":"message","numinlets":2,"numoutlets":1,"outlettype":[""],"patching_rect":[32,234,29.5,22],"text":"0"}},{"box":{"bgcolor":[0.9254901960784314,0.6823529411764706,0.043137254901960784,1],"id":"obj-66","maxclass":"newobj","numinlets":1,"numoutlets":1,"outlettype":[""],"patcher":{"fileversion":1,"appversion":{"major":9,"minor":1,"revision":5,"architecture":"x64","modernui":1},"classnamespace":"box","rect":[100,80,980,820],"boxes":[{"box":{"id":"title","maxclass":"comment","numinlets":1,"numoutlets":0,"patching_rect":[30,15,900,28],"text":"Retuning mode 0/1/2 — SCORE CUE"}},{"box":{"comment":"Cue input; see the protocol above. stop cancels this module’s active ramp.","id":"in","index":1,"maxclass":"inlet","numinlets":0,"numoutlets":1,"outlettype":[""],"patching_rect":[30,110,30,30]}},{"box":{"id":"route-stop","maxclass":"newobj","numinlets":2,"numoutlets":2,"outlettype":["",""],"patching_rect":[30,155,95,22],"text":"route stop"}},{"box":{"id":"protocol","maxclass":"comment","numinlets":1,"numoutlets":0,"patching_rect":[30,50,900,35