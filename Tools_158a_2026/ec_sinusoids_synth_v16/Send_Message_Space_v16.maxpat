on."}},{"box":{"id":"label0","maxclass":"comment","numinlets":1,"numoutlets":0,"patching_rect":[25,125,1000,22],"text":"Octave family (root, 0/1) | ROOT 0/1"}},{"box":{"id":"example0","maxclass":"message","numinlets":2,"numoutlets":1,"outlettype":[""],"patching_rect":[25,158,310,22],"text":"3 1"}},{"box":{"id":"model0","maxclass":"newobj","numinlets":1,"numoutlets":1,"outlettype":[""],"patcher":{"fileversion":1,"appversion":{"major":9,"minor":1,"revision":5,"architecture":"x64","modernui":1},"classnamespace":"box","rect":[100,80,980,820],"boxes":[{"box":{"id":"title","maxclass":"comment","numinlets":1,"numoutlets":0,"patching_rect":[30,15,900,28],"text":"Octave family (root, 0/1) — SCORE CUE"}},{"box":{"comment":"Cue input; see the protocol above. stop cancels this module’s active ramp.","id":"in","index":1,"maxclass":"inlet","numinlets":0,"numoutlets":1,"outlettype":[""],"patching_rect":[30,110,30,30]}},{"box":{"id":"route-stop","maxclass":"newobj","numinlets":2,"numoutlets":2,"outlettype":["",""],"patching_rect":[30,155,95,22],"text":"route stop"}},{"box":{"id":"protocol","maxclass":"comment","numinlets":1,"numoutlets":0,"patching_rect":[30,50,900,35],"text":"Input: ROOT STATE, e.g. 3 1 enables the 3/6/12/24… family. State 0 disables. Root is 2 or odd 3–255. No smoothing; stop is ignored."}},{"box":{"id":"list-only","maxclass":"newobj","numinlets":2,"numoutlets":2,"outlettype":["",""],"patching_rect":[165,205,105,22],"text":"routepass list"}},{"box":{"id":"name","maxclass":"newobj","numinlets":1,"numoutlets":1,"outlettype":[""],"patching_rect":[30,570,350,22],"text":"prepend Octave_Family_v16"}},{"box":{"id":"fan","maxclass":"newobj","numinlets":1,"numoutlets":3,"outlettype":["","",""],"patching_rect":[30,606,80,22],"text":"t l l l"}},{"box":{"id":"display-set","maxclass":"newobj","numinlets":1,"numoutlets":1,"outlettype":[""],"patching_rect":[425,606,90,22],"text":"prepend set"}},{"box":{"id":"display","maxclass":"message","numinlets":2,"numoutlets":1,"outlettype