                                            {
                                                "box": {
                                                    "code": "// Embedded Max 9 controller. All state lives inside this patch, via save/restore.\nautowatch = 0;\ninlets = 4;\noutlets = 6;\nvar owner = this.patcher;\nvar factory = factoryPreset();\nvar bank = { \"1\": clone(factory) };\nvar selected = 1, startupSlot = 1, lastStored = 0, lastRecalled = 0;\nvar pending = null, restoring = null, serial = 0;\nvar outputDicts = [new Dict(), new Dict(), new Dict()];\nvar timeoutTask = new Task(captureTimeout, this);\nvar settleTask = new Task(commitCapture, this);\nvar initializeTask = new Task(initializeNow, this);\n\nfunction clone(v) { return JSON.parse(JSON.stringify(v)); }\n// External live.gain~ controls are independent of every preset operation.\nfunction scenePreset(p) {\n    return { oper: clone(p.oper), spat: clone(p.spat), pan: clone(p.pan) };\n}\nfunction scalar(v) { return Array.isArray(v) ? v[0] : v; }\nfunction slotNumber(n) {\n    n = Number(n);\n    return Number.isInteger(n) && n >= 1 && n <= 128 ? n : 0;\n}\nfunction status(s) { outlet(3, \"set\", s); }\nfunction counters() {\n    outlet(5, \"set\", \"Last stored: \" + (lastStored || \"--\") + \"     Last recalled: \" + (lastRecalled || \"--\"));\n}\nfunction showSlot() {\n    outlet(4, \"set\", selected);\n    status(\"Preset \" + selected + \": \" + (bank[selected] ? \"occupied\" : \"EMPTY\") +\n           \"  |  \" + Object.keys(bank).length + \" stored\" +\n           (pending ? \"  |  capturing \" + pending.slot : \"\"));\n    counters();\n}\nfunction slot(n) {\n    n = slotNumber(n);\n    if (!n) { status(\"Choose a preset number from 1 to 128.\"); return; }\n    selected = n;\n    showSlot(); // Selecting never recalls or overwrites a sound.\n}\nfunction dirty() {\n    var p = owner;\n    while (p.parentpatcher) p = p.parentpatcher;\n    p.message(\"dirty\");\n}\nfunction skipAddress(a, section) {\n    // UI, diagnostics and snapshot banks are not part of the acoustic state.\n    if (/^\\/(window|display|snapshot|snapshots|preset|background|backgroundimage|grid|axis|legend|ruler|emphasis|speakerhull|settings|viewer|layout|style|usurp|status|version|cpu)(\\/|$)/.test(a)) return true;\n    if (section !== \"oper\") {\n        // Fixed DSP topology is set by @inputs/@outputs/@rooms/@internals.\n        // In particular, /speaker/number is not a spat5.spat~ setter.\n        if (/^\\/(sources?|speakers?|rooms?|inputs?|outputs?|internals?)\\/number$/.test(a)) return true;\n        if (/^\\/(inputs|outputs|rooms|internals|samplerate|vectorsize|signalvectorsize)$/.test(a)) return true;\n    }\n    return false;\n}\nfunction cleanState(raw, section) {\n    var result = {};\n    Object.keys(raw).forEach(function (key) {\n        var a = key.charAt(0) === \"/\" ? key : \"/\" + key;\n        if (!skipAddress(a, section)) result[a] = raw[key];\n    });\n    return result;\n}\nfunction validSection(s, kind) {\n    if (!s || typeof s !== \"object\" || Array.isArray(s)) return false;\n    if (kind === \"oper\") {\n        if (Number(scalar(s[\"/source/number\"])) !== 8 || Number(scalar(s[\"/speaker/number\"])) !== 8 || Number(scalar(s[\"/room/number\"])) !== 1) return false;\n        if (!Array.isArray(s[\"/speakers/aed\"]) || s[\"/speakers/aed\"].length !== 24) return false;\n        for (var i = 1; i <= 8; ++i) {\n            var aed = s[\"/source/\" + i + \"/aed\"];\n            if (!Array.isArray(aed) || aed.length !== 3 || !aed.every(Number.isFinite)) return false;\n        }\n        return s[\"/speakers/aed\"].every(Number.isFinite);\n    }\n    if (Object.keys(s).length < 4 || !s[\"/panning/type\"]) return false;\n    if (kind === \"pan\") return scalar(s[\"/panning/type\"]) === \"binaural\" && Object.keys(s).some(function(k) { return /^\\/hrtf(\\/|$)/.test(k); });\n    return true;\n}\nfunction validPreset(p) {\n    return p && validSection(p.oper, \"oper\") && validSection(p.spat, \"spat\") && validSection(p.pan, \"pan\");\n}\nfunction dictionary(name) {\n    if (!pending || inlet < 1 || inlet > 3) return;\n    var kind = [\"\", \"oper\", \"spat\", \"pan\"][inlet];\n    try {\n        // Copy immediately: o.dict reuses its dictionary on the next packet.\n        var d = new Dict(name);\n        var state = cleanState(JSON.parse(d.stringify()), kind);\n        Object.keys(state).forEach(function(k) { pending[kind][k] = state[k]; });\n        ready();\n    } catch (e) {\n        pending.error = kind + \": \" + e.message;\n    }\n}\nfunction store() {\n    if (restoring) { status(\"Bank restore incomplete; STORE blocked to preserve saved data.\"); return; }\n    if (pending) { status(\"Still capturing preset \" + pending.slot + \".\"); return; }\n    pending = { slot: selected, token: ++serial, oper: {}, spat: {}, pan: {} };\n    status(\"Capturing preset \" + pending.slot + \"...\");\n    timeoutTask.cancel(); settleTask.cancel();\n    timeoutTask.schedule(2500);\n    outlet(1, \"/dump\");\n    outlet(2, \"/dump\");\n    outlet(0, \"/dump\");\n}\nfunction ready() {\n    settleTask.cancel();\n    if (pending && validPreset(pending)) settleTask.schedule(80);\n}\nfunction commitCapture() {\n    if (!pending || !validPreset(pending)) return;\n    var p = pending;\n    pending = null;\n    timeoutTask.cancel();\n    // Only now overwrite the requested slot: incomplete captures never erase it.\n    bank[p.slot] = scenePreset(p);\n    lastStored = p.slot;\n    startupSlot = p.slot;\n    dirty();\n    showSlot();\n    status(\"Stored preset \" + p.slot + \"  |  Cmd+S saves the bank\" + (selected !== p.slot ? \"  |  selected \" + selected : \"\"));\n}\nfunction captureTimeout() {\n    if (!pending) return;\n    var missing = [];\n    [\"oper\", \"spat\", \"pan\"].forEach(function(k) { if (!validSection(pending[k], k)) missing.push(k); });\n    var n = pending.slot, detail = pending.error;\n    pending = null;\n    settleTask.cancel();\n    status(\"NOT stored \" + n + \": check \" + missing.join(\", \") + \"  |  previous slot kept\");\n    error(\"SPAT preset \" + n + \" capture incomplete: \" + missing.join(\", \") + (detail ? \" (\" + detail + \")\" : \"\") + \"\\n\");\n}\nfunction emitState(port, state) {\n    outputDicts[port].parse(JSON.stringify(state));\n    outlet(port, \"dictionary\", outputDicts[port].name);\n}\nfunction applyPreset(n, initial) {\n    var p = bank[n];\n    if (!validPreset(p)) { status(\"Preset \" + n + \" is EMPTY or invalid; sound unchanged.\"); return; }\n    // Restore renderer settings, then headphone rendering. Oper is authoritative\n    // for the acoustic scene and speaker geometry; its final bang rebuilds both.\n    emitState(1, p.spat);\n    emitState(2, p.pan);\n    emitState(0, p.oper);\n    outlet(0, \"bang\");\n    startupSlot = n; lastRecalled = n;\n    if (!initial) dirty();\n    showSlot();\n    status(\"Recalled preset \" + n + (selected !== n ? \"  |  selected \" + selected + (bank[selected] ? \" (occupied)\" : \" (EMPTY)\") : \"\"));\n}\nfunction recall() {\n    if (restoring) { status(\"Bank restore incomplete; RECALL blocked.\"); return; }\n    if (pending) { status(\"Wait: capturing preset \" + pending.slot + \".\"); return; }\n    applyPreset(selected, false);\n}\nfunction initialize() {\n    // Run after Max has restored all embedded messages and parameter initials.\n    initializeTask.cancel();\n    initializeTask.schedule(100);\n}\nfunction initializeNow() {\n    if (restoring) { status(\"Preset bank restore incomplete; no recall performed.\"); return; }\n    applyPreset(bank[startupSlot] ? startupSlot : 1, true);\n}\nfunction save() {\n    // Chunk JSON so each embedded Max symbol stays small. Save all occupied slots.\n    if (restoring) {\n        // Preserve the original saved payload if restoring failed validation.\n        embedmessage(\"restorebegin\", restoring.version, restoring.selected, restoring.startup, restoring.stored);\n        Object.keys(restoring.chunks).forEach(function(k) {\n            var s = restoring.chunks[k];\n            for (var i = 0; i < s.length; i += 2048) embedmessage(\"restorechunk\", Number(k), s.substring(i, i + 2048));\n        });\n        embedmessage(\"restoreend\");\n        return;\n    }\n    embedmessage(\"restorebegin\", 1, selected, startupSlot, lastStored);\n    Object.keys(bank).sort(function(a,b) { return Number(a)-Number(b); }).forEach(function(k) {\n        var s = JSON.stringify(bank[k]);\n        for (var i = 0; i < s.length; i += 2048) embedmessage(\"restorechunk\", Number(k), s.substring(i, i + 2048));\n    });\n    embedmessage(\"restoreend\");\n}\nfunction restorebegin(version, target, startup, stored) {\n    restoring = { version: version, selected: target, startup: startup, stored: stored, chunks: {} };\n}\nfunction restorechunk(n, s) {\n    if (!restoring || !slotNumber(n)) return;\n    restoring.chunks[n] = (restoring.chunks[n] || \"\") + String(s);\n}\nfunction restoreend() {\n    if (!restoring) return;\n    try {\n        if (restoring.version !== 1) throw new Error(\"unknown bank version\");\n        var restored = {};\n        Object.keys(restoring.chunks).forEach(function(k) {\n            var p = JSON.parse(restoring.chunks[k]);\n            if (!validPreset(p)) throw new Error(\"invalid slot \" + k);\n            restored[k] = scenePreset(p); // Discard obsolete external fader fields from older banks.\n        });\n        if (!Object.keys(restored).length) throw new Error(\"empty saved bank\");\n        bank = restored;\n        selected = slotNumber(restoring.selected) || 1;\n        startupSlot = bank[restoring.startup] ? Number(restoring.startup) : Number(Object.keys(bank)[0]);\n        lastStored = bank[restoring.stored] ? Number(restoring.stored) : 0;\n        restoring = null;\n    } catch (e) {\n        // Leave restoring non-null: never silently replace a corrupt bank on load.\n        error(\"SPAT numbered bank could not be restored: \" + e.message + \"\\n\");\n    }\n}\nfunction notifydeleted() {\n    timeoutTask.cancel(); settleTask.cancel(); initializeTask.cancel();\n}\n\nfunction factoryPreset() { return {\"oper\":{\"/source/number\":8,\"/source/1/aed\":[-45.0,0.0,1.0],\"/source/1/constraint/circular\":false,\"/source/1/orientation/mode\":\"default\",\"/source/1/orientation\":[0.0,0.0,0.0,1.0],\"/source/1/lookat/xyz\":[0.0,0.0,0.0],\"/source/1/label\":\"1\",\"/source/1/aperture\":80.0,\"/source/2/aed\":[0.0,0.0,1.0],\"/source/2/constraint/circular\":false,\"/source/2/orientation/mode\":\"default\",\"/source/2/orientation\":[0.0,0.0,0.0,1.0],\"/source/2/lookat/xyz\":[0.0,0.0,0.0],\"/source/2/label\":\"2\",\"/source/2/aperture\":80.0,\"/source/3/aed\":[45.0,0.0,1.0],\"/source/3/constraint/circular\":false,\"/source/3/orientation/mode\":\"default\",\"/source/3/orientation\":[0.0,0.0,0.0,1.0],\"/source/3/lookat/xyz\":[0.0,0.0,0.0],\"/source/3/label\":\"3\",\"/source/3/aperture\":80.0,\"/source/4/aed\":[90.0,0.0,1.0],\"/source/4/constraint/circular\":false,\"/source/4/orientation/mode\":\"default\",\"/source/4/orientation\":[0.0,0.0,0.0,1.0],\"/source/4/lookat/xyz\":[0.0,0.0,0.0],\"/source/4/label\":\"4\",\"/source/4/aperture\":80.0,\"/source/5/aed\":[135.0,0.0,1.0],\"/source/5/constraint/circular\":false,\"/source/5/orientation/mode\":\"default\",\"/source/5/orientation\":[0.0,0.0,0.0,1.0],\"/source/5/lookat/xyz\":[0.0,0.0,0.0],\"/source/5/label\":\"5\",\"/source/5/aperture\":80.0,\"/source/6/aed\":[180.0,0.0,1.0],\"/source/6/constraint/circular\":false,\"/source/6/orientation/mode\":\"default\",\"/source/6/orientation\":[0.0,0.0,0.0,1.0],\"/source/6/lookat/xyz\":[0.0,0.0,0.0],\"/source/6/label\":\"6\",\"/source/6/aperture\":80.0,\"/source/7/aed\":[-135.0,0.0,1.0],\"/source/7/constraint/circular\":false,\"/source/7/orientation/mode\":\"default\",\"/source/7/orientation\":[0.0,0.0,0.0,1.0],\"/source/7/lookat/xyz\":[0.0,0.0,0.0],\"/source/7/label\":\"7\",\"/source/7/aperture\":80.0,\"/source/8/aed\":[-90.0,0.0,1.0],\"/source/8/constraint/circular\":false,\"/source/8/orientation/mode\":\"def