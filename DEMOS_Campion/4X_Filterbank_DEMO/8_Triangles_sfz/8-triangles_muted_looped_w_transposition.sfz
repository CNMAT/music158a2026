// New SFZ instrument
// Blank table values inherit settings or use sampler defaults.

<global>
volume=0.0
ampeg_release=0.2

 // Assign a voice group number for choking other voices.
 // Stop this voice when a new voice in group 2 starts.

<group> // Group ID 1
 // Imported samples
loop_mode=loop_continuous // Choose looping and response to note-off.
loop_start=0 // First frame of the sample loop, counted from zero.
loop_end=47999 // Last frame of the loop, inclusive.

output=0 // Stereo pair index: 0=ch1/2, 1=ch3/4, 2=ch5/6, 3=ch7/8.

group=2 // Assign a voice group number for choking other voices.
off_by=2 // Stop this voice when a new voice in group 2 starts.
off_mode=fast // How a choked voice ends: fast or normal envelope release.

<region> // Region ID 1; Group ID 1
sample=triang-metal_250ms.wav

lovel=1
hivel=127


loop_end=4000 // Last frame of the loop, inclusive.

lokey=32
hikey=40
pitch_keycenter=36

output=0 // Stereo pair index: 0=ch1/2, 1=ch3/4, 2=ch5/6, 3=ch7/8.

group=100 // Assign a voice group number for choking other voices.
off_by=100 // Stop this voice when a new voice in group 2 starts.
off_mode=fast // How a choked voice ends: fast or normal envelope release.

<region> // Region ID 2; Group ID 1
sample=triang-metal_350ms.wav

lovel=1
hivel=127


loop_end=5333 // Last frame of the loop, inclusive.

lokey=41
hikey=49
pitch_keycenter=45

output=1 // Stereo pair index: 0=ch1/2, 1=ch3/4, 2=ch5/6, 3=ch7/8.

group=200 // Assign a voice group number for choking other voices.
off_by=200 // Stop this voice when a new voice in group 2 starts.
off_mode=fast // How a choked voice ends: fast or normal envelope release.

