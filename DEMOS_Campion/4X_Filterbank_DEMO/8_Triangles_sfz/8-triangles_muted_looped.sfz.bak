// New SFZ instrument
// Blank table values inherit settings or use sampler defaults.

<global>
volume=0.0
ampeg_release=0.2

<group> // Group ID 1
 // Imported samples
loop_mode=loop_continuous // Choose looping and response to note-off.
loop_start=0 // First frame of the sample loop, counted from zero.
loop_end=47999 // Last frame of the loop, inclusive.

output=0 // Stereo pair index: 0=ch1/2, 1=ch3/4, 2=ch5/6, 3=ch7/8.

<region> // Region ID 1; Group ID 1
sample=triang-metal_250ms.wav

lovel=1
hivel=127


loop_end=4000 // Last frame of the loop, inclusive.

lokey=60
hikey=60
pitch_keycenter=60

output=0 // Stereo pair index: 0=ch1/2, 1=ch3/4, 2=ch5/6, 3=ch7/8.

